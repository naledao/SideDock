<UserControl
    x:Class="SideDock.Host.App.StaticAudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AudioPageBackgroundBrush" Color="#F6F8FA" />
        <SolidColorBrush x:Key="AudioPanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AudioStrokeBrush" Color="#D8DEE4" />
        <SolidColorBrush x:Key="AudioTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="AudioMutedBrush" Color="#5B6570" />
        <SolidColorBrush x:Key="AudioPrimaryBrush" Color="#087C89" />
        <SolidColorBrush x:Key="AudioBlueBrush" Color="#0B73D9" />
        <SolidColorBrush x:Key="AudioSuccessBrush" Color="#168A29" />
        <SolidColorBrush x:Key="AudioWarningBrush" Color="#C77C00" />
        <SolidColorBrush x:Key="AudioSoftWarningBrush" Color="#FFF8ED" />

        <Style x:Key="AudioCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{StaticResource AudioPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AudioStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="AudioOutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource AudioStrokeBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AudioTextBrush}" />
        </Style>

        <Style x:Key="AudioPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{StaticResource AudioPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AudioPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AudioPageBackgroundBrush}">
        <ScrollViewer
            Padding="26,0,26,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Height="74"
                    Padding="16,0"
                    CornerRadius="7"
                    Background="{StaticResource AudioSoftWarningBrush}"
                    BorderBrush="#D68B00"
                    BorderThickness="1">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="38"
                            Height="38"
                            CornerRadius="6"
                            Background="#C77C00"
                            VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7BA;" FontSize="24" Foreground="White" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <TextBlock
                                Text="音频桥接需要选择端点"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AudioWarningBrush}" />
                            <TextBlock
                                Text="请完成麦克风端点绑定以后启用双向音频。"
                                FontSize="13"
                                Foreground="#30363D" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="5"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="关闭提示">
                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="#111827" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.85*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="14">
                        <Border
                            Height="242"
                            Padding="20,18"
                            Style="{StaticResource AudioCardStyle}">
                            <Grid RowSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="电脑声音发送到 Android"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AudioTextBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                        <TextBlock
                                            Text="已启用"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#30363D" />
                                        <ToggleSwitch IsOn="True" />
                                    </StackPanel>
                                </Grid>

                                <Rectangle
                                    Grid.Row="0"
                                    Height="1"
                                    Margin="0,34,0,0"
                                    VerticalAlignment="Bottom"
                                    Fill="{StaticResource AudioStrokeBrush}" />

                                <Grid Grid.Row="1" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="0.95*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="音频源（电脑输出）" VerticalAlignment="Center" Foreground="#30363D" />
                                        <ComboBox Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="扬声器（Realtek Audio）" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Text="捕获模式" VerticalAlignment="Center" Foreground="#30363D" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Loopback" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Text="目标设备（Android）" VerticalAlignment="Center" Foreground="#30363D" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Android 音响" />
                                        </ComboBox>
                                    </Grid>

                                    <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource AudioStrokeBrush}" />

                                    <Grid Grid.Column="2" RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="音量" VerticalAlignment="Center" Foreground="#30363D" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE995;" FontSize="16" Margin="0,0,8,0" Foreground="#30363D" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="#CBD5DE" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="#CBD5DE" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="#CBD5DE" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="#CBD5DE" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="78%" VerticalAlignment="Center" Foreground="#30363D" />

                                        <TextBlock Grid.Row="1" Text="状态" VerticalAlignment="Center" Foreground="#30363D" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource AudioSuccessBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="可用" FontWeight="SemiBold" Foreground="{StaticResource AudioSuccessBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Text="延迟" VerticalAlignment="Center" Foreground="#30363D" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="23 ms" Foreground="#30363D" />

                                        <Button
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            MinWidth="124"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource AudioOutlineButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="#30363D" />
                                                <TextBlock Text="测试播放" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border
                            Height="230"
                            Padding="20,18"
                            Style="{StaticResource AudioCardStyle}">
                            <Grid RowSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="Android 麦克风写入 Windows"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AudioTextBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                        <TextBlock
                                            Text="已启用"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#30363D" />
                                        <ToggleSwitch IsOn="True" />
                                    </StackPanel>
                                </Grid>

                                <Rectangle
                                    Grid.Row="0"
                                    Height="1"
                                    Margin="0,34,0,0"
                                    VerticalAlignment="Bottom"
                                    Fill="{StaticResource AudioStrokeBrush}" />

                                <Grid Grid.Row="1" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="0.85*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="174" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Text="麦克风端点（Windows 输入）"
                                            VerticalAlignment="Center"
                                            Foreground="#30363D" />
                                        <ComboBox Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="CABLE Output (VB-Audio Virtual Cable)" />
                                        </ComboBox>
                                        <Button
                                            Grid.Column="2"
                                            Width="36"
                                            Height="34"
                                            Padding="0"
                                            CornerRadius="5"
                                            Background="Transparent"
                                            BorderThickness="0">
                                            <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="#111827" />
                                        </Button>

                                        <TextBlock
                                            Grid.Row="1"
                                            Text="渲染端点（Windows 输出）"
                                            VerticalAlignment="Center"
                                            Foreground="#30363D" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="CABLE Input (VB-Audio Virtual Cable)" />
                                        </ComboBox>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Width="36"
                                            Height="34"
                                            Padding="0"
                                            CornerRadius="5"
                                            Background="Transparent"
                                            BorderThickness="0">
                                            <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="#111827" />
                                        </Button>
                                    </Grid>

                                    <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource AudioStrokeBrush}" />

                                    <Grid Grid.Column="2" RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="输入电平" VerticalAlignment="Center" Foreground="#30363D" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE720;" FontSize="16" Margin="0,0,8,0" Foreground="#30363D" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AudioBlueBrush}" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="#CBD5DE" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="#CBD5DE" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="#CBD5DE" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="#CBD5DE" />
                                            <Rectangle Width="6" Height="14" RadiusX="1" RadiusY="1" Fill="#CBD5DE" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="65%" VerticalAlignment="Center" Foreground="#30363D" />

                                        <TextBlock Grid.Row="1" Text="状态" VerticalAlignment="Center" Foreground="#30363D" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{StaticResource AudioWarningBrush}" />
                                            <TextBlock Text="需要绑定" FontWeight="SemiBold" Foreground="{StaticResource AudioWarningBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Text="延迟" VerticalAlignment="Center" Foreground="#30363D" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="--" Foreground="#30363D" />

                                        <Button
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            MinWidth="124"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource AudioOutlineButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE720;" FontSize="16" Foreground="#30363D" />
                                                <TextBlock Text="测试录音" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#30363D" />
                            <TextBlock
                                Text="提示：请确保虚拟音频线已安装，并在 Windows 声音设置中设置为默认设备（如需要）。"
                                FontSize="12"
                                Foreground="{StaticResource AudioMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="18"
                        Style="{StaticResource AudioCardStyle}">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Text="端点向导"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AudioTextBrush}" />
                            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource AudioStrokeBrush}" />

                            <Grid Grid.Row="2" RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="68" />
                                    <RowDefinition Height="68" />
                                    <RowDefinition Height="68" />
                                    <RowDefinition Height="68" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AudioPrimaryBrush}">
                                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="安装虚拟音频线" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                        <TextBlock Text="安装或修复 VB-Audio Virtual Cable。" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="17" Foreground="{StaticResource AudioSuccessBrush}" />
                                </Grid>

                                <Grid Grid.Row="1" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#FFFFFF" BorderBrush="{StaticResource AudioStrokeBrush}" BorderThickness="1">
                                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="选择电脑输出" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                        <TextBlock Text="选择要发送到 Android 的电脑声音源。" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="17" Foreground="{StaticResource AudioSuccessBrush}" />
                                </Grid>

                                <Grid Grid.Row="2" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#FFFFFF" BorderBrush="{StaticResource AudioStrokeBrush}" BorderThickness="1">
                                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="选择麦克风端点" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                        <TextBlock Text="将 CABLE Output 绑定为麦克风输入。" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE7BA;" FontSize="17" Foreground="{StaticResource AudioWarningBrush}" />
                                </Grid>

                                <Grid Grid.Row="3" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#FFFFFF" BorderBrush="{StaticResource AudioStrokeBrush}" BorderThickness="1">
                                        <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="测试回声" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                        <TextBlock Text="测试双向音频是否正常工作。" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                    </StackPanel>
                                    <Ellipse Grid.Column="2" Width="18" Height="18" Stroke="{StaticResource AudioStrokeBrush}" StrokeThickness="1" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="4" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource AudioPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE90F;" FontSize="18" Foreground="White" />
                                        <TextBlock Text="修复端点" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="1"
                                    Width="52"
                                    Height="42"
                                    Padding="0"
                                    CornerRadius="5"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource AudioStrokeBrush}">
                                    <FontIcon Glyph="&#xE712;" FontSize="17" Foreground="#111827" />
                                </Button>
                            </Grid>

                            <Border
                                Grid.Row="5"
                                Padding="12"
                                CornerRadius="5"
                                Background="#F8FAFC"
                                BorderBrush="#8FB8FF"
                                BorderThickness="1">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="#30363D" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="修复端点将自动安装虚拟线缆并设置默认端点。"
                                        FontSize="12"
                                        Foreground="#30363D"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="14" Style="{StaticResource AudioCardStyle}">
                        <StackPanel Spacing="11">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE720;" FontSize="19" Foreground="#30363D" />
                                <TextBlock Text="麦克风" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{StaticResource AudioStrokeBrush}" />
                            <Grid RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
