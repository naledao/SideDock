<UserControl
    x:Class="SideDock.Host.App.StaticAudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AudioPageBackgroundBrush" Color="#F6F8FA" />
        <SolidColorBrush x:Key="AudioPanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AudioStrokeBrush" Color="#D8DEE4" />
        <SolidColorBrush x:Key="AudioTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="AudioMutedBrush" Color="#5B6570" />
        <SolidColorBrush x:Key="AudioPrimaryBrush" Color="#087C89" />
        <SolidColorBrush x:Key="AudioBlueBrush" Color="#0B73D9" />
        <SolidColorBrush x:Key="AudioSuccessBrush" Color="#168A29" />
        <SolidColorBrush x:Key="AudioWarningBrush" Color="#C77C00" />
        <SolidColorBrush x:Key="AudioSoftWarningBrush" Color="#FFF8ED" />

        <Style x:Key="AudioCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{StaticResource AudioPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AudioStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="AudioOutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource AudioStrokeBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AudioTextBrush}" />
        </Style>

        <Style x:Key="AudioPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{StaticResource AudioPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AudioPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AudioPageBackgroundBrush}">
        <ScrollViewer
            Padding="26,0,26,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="AudioStatusBanner"
                    Height="74"
                    Padding="16,0"
                    CornerRadius="7"
                    Background="{StaticResource AudioSoftWarningBrush}"
                    BorderBrush="#D68B00"
                    BorderThickness="1">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="AudioStatusBannerIconBackground"
                            Width="38"
                            Height="38"
                            CornerRadius="6"
                            Background="#C77C00"
                            VerticalAlignment="Center">
                            <FontIcon
                                x:Name="AudioStatusBannerIcon"
                                Glyph="&#xE7BA;"
                                FontSize="24"
                                Foreground="White" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <TextBlock
                                x:Name="AudioStatusBannerTitleText"
                                Text="音频状态"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AudioWarningBrush}" />
                            <TextBlock
                                x:Name="AudioStatusBannerMessageText"
                                Text="正在读取真实音频状态。"
                                FontSize="13"
                                Foreground="#30363D"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button
                            x:Name="AudioStatusBannerCloseButton"
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Click="StatusBannerCloseButton_Click"
                            CornerRadius="5"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="关闭提示">
                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="#111827" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.85*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="14">
                        <Border Height="242" Padding="20,18" Style="{StaticResource AudioCardStyle}">
                            <Grid RowSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="电脑声音发送到 Android" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                        <TextBlock x:Name="SpeakerToggleStatusText" Text="未启用" VerticalAlignment="Center" FontSize="13" Foreground="#30363D" />
                                        <ToggleSwitch x:Name="SpeakerOutputToggle" Toggled="SpeakerOutputToggle_Toggled" />
                                    </StackPanel>
                                </Grid>

                                <Rectangle Grid.Row="0" Height="1" Margin="0,34,0,0" VerticalAlignment="Bottom" Fill="{StaticResource AudioStrokeBrush}" />

                                <Grid Grid.Row="1" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="0.95*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="音频源（电脑输出）" VerticalAlignment="Center" Foreground="#30363D" />
                                        <ComboBox x:Name="SpeakerEndpointCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="SpeakerEndpointCombo_SelectionChanged" />
                                        <Button x:Name="RefreshEndpointsButton" Grid.Column="2" Width="36" Height="34" Padding="0" Click="RefreshEndpointsButton_Click" CornerRadius="5" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="刷新端点">
                                            <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="#111827" />
                                        </Button>
                                        <TextBlock x:Name="SpeakerEndpointStatusText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="暂无端点数据" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />

                                        <TextBlock Grid.Row="2" Text="捕获模式" VerticalAlignment="Center" Foreground="#30363D" />
                                        <TextBlock x:Name="SpeakerCaptureModeText" Grid.Row="2" Grid.Column="1" Text="WASAPI Loopback" Foreground="#30363D" />

                                        <TextBlock Grid.Row="3" Text="目标设备（Android）" VerticalAlignment="Center" Foreground="#30363D" />
                                        <TextBlock x:Name="SpeakerTargetDeviceText" Grid.Row="3" Grid.Column="1" Text="等待 Android 设备" Foreground="#30363D" TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource AudioStrokeBrush}" />

                                    <Grid Grid.Column="2" RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="音量" VerticalAlignment="Center" Foreground="#30363D" />
                                        <TextBlock x:Name="SpeakerLevelText" Grid.Column="1" Grid.ColumnSpan="2" Text="暂无实时数据" Foreground="#30363D" />

                                        <TextBlock Grid.Row="1" Text="状态" VerticalAlignment="Center" Foreground="#30363D" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                            <FontIcon x:Name="SpeakerCardStatusIcon" Glyph="&#xE946;" FontSize="16" Foreground="{StaticResource AudioMutedBrush}" />
                                            <TextBlock x:Name="SpeakerCardStatusText" Text="暂无数据" FontWeight="SemiBold" Foreground="{StaticResource AudioMutedBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Text="延迟" VerticalAlignment="Center" Foreground="#30363D" />
                                        <TextBlock x:Name="SpeakerLatencyText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="暂无数据" Foreground="#30363D" />

                                        <Button x:Name="TestPlaybackButton" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" MinWidth="124" HorizontalAlignment="Right" IsEnabled="False" ToolTipService.ToolTip="暂未实现" Style="{StaticResource AudioOutlineButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="#30363D" />
                                                <TextBlock Text="测试播放" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Height="230" Padding="20,18" Style="{StaticResource AudioCardStyle}">
                            <Grid RowSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Android 麦克风写入 Windows" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                        <TextBlock x:Name="MicrophoneToggleStatusText" Text="未启用" VerticalAlignment="Center" FontSize="13" Foreground="#30363D" />
                                        <ToggleSwitch x:Name="MicrophoneInputToggle" Toggled="MicrophoneInputToggle_Toggled" />
                                    </StackPanel>
                                </Grid>

                                <Rectangle Grid.Row="0" Height="1" Margin="0,34,0,0" VerticalAlignment="Bottom" Fill="{StaticResource AudioStrokeBrush}" />

                                <Grid Grid.Row="1" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="0.85*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="174" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="麦克风写入端点" VerticalAlignment="Center" Foreground="#30363D" />
                                        <ComboBox x:Name="MicrophoneEndpointCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="MicrophoneEndpointCombo_SelectionChanged" />
                                        <Button x:Name="RefreshMicrophoneEndpointsButton" Grid.Column="2" Width="36" Height="34" Padding="0" Click="RefreshEndpointsButton_Click" CornerRadius="5" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="刷新端点">
                                            <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="#111827" />
                                        </Button>

                                        <TextBlock x:Name="MicrophoneEndpointStatusText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="暂无端点数据" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="2" Text="目标设备（Android）" VerticalAlignment="Center" Foreground="#30363D" />
                                        <TextBlock x:Name="MicrophoneTargetDeviceText" Grid.Row="2" Grid.Column="1" Text="等待 Android 设备" Foreground="#30363D" TextTrimming="CharacterEllipsis" />
                                        <Button x:Name="RefreshMicrophoneRenderButton" Grid.Row="2" Grid.Column="2" Width="36" Height="34" Padding="0" Click="RefreshEndpointsButton_Click" CornerRadius="5" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="刷新端点">
                                            <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="#111827" />
                                        </Button>
                                    </Grid>

                                    <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource AudioStrokeBrush}" />

                                    <Grid Grid.Column="2" RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="输入电平" VerticalAlignment="Center" Foreground="#30363D" />
                                        <TextBlock x:Name="MicrophoneLevelText" Grid.Column="1" Grid.ColumnSpan="2" Text="暂无实时数据" Foreground="#30363D" />

                                        <TextBlock Grid.Row="1" Text="状态" VerticalAlignment="Center" Foreground="#30363D" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                            <FontIcon x:Name="MicrophoneCardStatusIcon" Glyph="&#xE946;" FontSize="16" Foreground="{StaticResource AudioMutedBrush}" />
                                            <TextBlock x:Name="MicrophoneCardStatusText" Text="暂无数据" FontWeight="SemiBold" Foreground="{StaticResource AudioMutedBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Text="延迟" VerticalAlignment="Center" Foreground="#30363D" />
                                        <TextBlock x:Name="MicrophoneLatencyText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="暂无数据" Foreground="#30363D" />

                                        <Button x:Name="TestRecordingButton" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" MinWidth="124" HorizontalAlignment="Right" IsEnabled="False" ToolTipService.ToolTip="暂未实现" Style="{StaticResource AudioOutlineButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE720;" FontSize="16" Foreground="#30363D" />
                                                <TextBlock Text="测试录音" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#30363D" />
                            <TextBlock x:Name="AudioInlineHintText" Text="暂无数据。" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Padding="18" Style="{StaticResource AudioCardStyle}">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="端点向导" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource AudioStrokeBrush}" />

                            <Grid Grid.Row="2" RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="68" />
                                    <RowDefinition Height="68" />
                                    <RowDefinition Height="68" />
                                    <RowDefinition Height="68" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AudioPrimaryBrush}">
                                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="安装虚拟音频线" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                        <TextBlock Text="安装或修复 VB-Audio Virtual Cable。" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                    </StackPanel>
                                    <FontIcon x:Name="WizardInstallStepIcon" Grid.Column="2" Glyph="&#xE10A;" FontSize="17" Foreground="{StaticResource AudioMutedBrush}" />
                                </Grid>

                                <Grid Grid.Row="1" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#FFFFFF" BorderBrush="{StaticResource AudioStrokeBrush}" BorderThickness="1">
                                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="选择电脑输出" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                        <TextBlock Text="选择要发送到 Android 的电脑声音源。" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                    </StackPanel>
                                    <FontIcon x:Name="WizardSpeakerStepIcon" Grid.Column="2" Glyph="&#xE10A;" FontSize="17" Foreground="{StaticResource AudioMutedBrush}" />
                                </Grid>

                                <Grid Grid.Row="2" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#FFFFFF" BorderBrush="{StaticResource AudioStrokeBrush}" BorderThickness="1">
                                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="选择麦克风端点" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                        <TextBlock Text="选择可写入的虚拟音频端点。" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                    </StackPanel>
                                    <FontIcon x:Name="WizardMicrophoneStepIcon" Grid.Column="2" Glyph="&#xE10A;" FontSize="17" Foreground="{StaticResource AudioMutedBrush}" />
                                </Grid>

                                <Grid Grid.Row="3" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#FFFFFF" BorderBrush="{StaticResource AudioStrokeBrush}" BorderThickness="1">
                                        <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="测试回声" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                                        <TextBlock Text="暂未实现真实测试协议。" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                    </StackPanel>
                                    <FontIcon x:Name="WizardTestStepIcon" Grid.Column="2" Glyph="&#xE711;" FontSize="17" Foreground="{StaticResource AudioMutedBrush}" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="4" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="RepairEndpointsButton" Click="InstallVirtualAudioCableButton_Click" Style="{StaticResource AudioPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE90F;" FontSize="18" Foreground="White" />
                                        <TextBlock Text="修复端点" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TestEchoButton" Grid.Column="1" IsEnabled="False" ToolTipService.ToolTip="暂未实现" Style="{StaticResource AudioOutlineButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE720;" FontSize="16" Foreground="#30363D" />
                                        <TextBlock Text="测试回声" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WizardOpenSoundSettingsButton" Grid.Column="2" Width="52" Height="42" Padding="0" Click="OpenSoundSettingsButton_Click" CornerRadius="5" Background="#FFFFFF" BorderBrush="{StaticResource AudioStrokeBrush}" ToolTipService.ToolTip="打开声音设置">
                                    <FontIcon Glyph="&#xE713;" FontSize="17" Foreground="#111827" />
                                </Button>
                            </Grid>

                            <Border Grid.Row="5" Padding="12" CornerRadius="5" Background="#F8FAFC" BorderBrush="#8FB8FF" BorderThickness="1">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="#30363D" />
                                    <TextBlock x:Name="WizardRepairHintText" Grid.Column="1" Text="修复端点会启动已有的虚拟音频线安装/修复流程。" FontSize="12" Foreground="#30363D" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="14" Style="{StaticResource AudioCardStyle}">
                        <StackPanel Spacing="11">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE720;" FontSize="19" Foreground="#30363D" />
                                <TextBlock Text="麦克风" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{StaticResource AudioStrokeBrush}" />
                            <Grid RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="端点" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                <TextBlock x:Name="MicrophoneEndpointSummaryText" Grid.Column="1" Text="未绑定" FontSize="12" Foreground="#30363D" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Text="状态" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="MicrophoneSummaryStatusIcon" Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource AudioMutedBrush}" />
                                    <TextBlock x:Name="MicrophoneSummaryStatusText" Text="暂无数据" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AudioMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="格式" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                <TextBlock x:Name="MicrophoneFormatText" Grid.Row="2" Grid.Column="1" Text="48 kHz, 16-bit, 2ch" FontSize="12" Foreground="#30363D" />
                                <TextBlock Grid.Row="3" Text="电平" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                <TextBlock x:Name="MicrophoneLevelSummaryText" Grid.Row="3" Grid.Column="1" Text="暂无实时数据" FontSize="12" Foreground="#30363D" />
                            </Grid>
                            <Button x:Name="MicrophoneOpenSoundSettingsButton" Click="OpenSoundSettingsButton_Click" Style="{StaticResource AudioOutlineButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="#30363D" />
                                    <TextBlock Text="打开声音设置" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="14" Style="{StaticResource AudioCardStyle}">
                        <StackPanel Spacing="11">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE995;" FontSize="19" Foreground="#30363D" />
                                <TextBlock Text="音响" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{StaticResource AudioStrokeBrush}" />
                            <Grid RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="端点" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                <TextBlock x:Name="SpeakerEndpointSummaryText" Grid.Column="1" Text="未绑定" FontSize="12" Foreground="#30363D" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Text="状态" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="SpeakerSummaryStatusIcon" Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource AudioMutedBrush}" />
                                    <TextBlock x:Name="SpeakerSummaryStatusText" Text="暂无数据" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AudioMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="格式" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                <TextBlock x:Name="SpeakerFormatText" Grid.Row="2" Grid.Column="1" Text="48 kHz, 16-bit, 2ch" FontSize="12" Foreground="#30363D" />
                                <TextBlock Grid.Row="3" Text="音量" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                <TextBlock x:Name="SpeakerLevelSummaryText" Grid.Row="3" Grid.Column="1" Text="暂无实时数据" FontSize="12" Foreground="#30363D" />
                            </Grid>
                            <Button x:Name="SpeakerOpenSoundSettingsButton" Click="OpenSoundSettingsButton_Click" Style="{StaticResource AudioOutlineButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="#30363D" />
                                    <TextBlock Text="打开声音设置" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="14" Style="{StaticResource AudioCardStyle}">
                        <StackPanel Spacing="11">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE9D9;" FontSize="19" Foreground="#30363D" />
                                <TextBlock Text="虚拟线缆" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{StaticResource AudioStrokeBrush}" />
                            <Grid RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="驱动" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="VB-Audio Virtual Cable" FontSize="12" Foreground="#30363D" />
                                <TextBlock Grid.Row="1" Text="状态" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="VirtualCableStatusIcon" Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource AudioMutedBrush}" />
                                    <TextBlock x:Name="VirtualCableStatusText" Text="暂无数据" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AudioMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="版本" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                <TextBlock x:Name="VirtualCableVersionText" Grid.Row="2" Grid.Column="1" Text="不可用" FontSize="12" Foreground="#30363D" />
                                <TextBlock Grid.Row="3" Text="端点" FontSize="12" Foreground="{StaticResource AudioMutedBrush}" />
                                <TextBlock x:Name="VirtualCableEndpointText" Grid.Row="3" Grid.Column="1" Text="暂无数据" FontSize="12" Foreground="#30363D" />
                            </Grid>
                            <Button x:Name="ReloadVirtualCableButton" Click="InstallVirtualAudioCableButton_Click" Style="{StaticResource AudioOutlineButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="#30363D" />
                                    <TextBlock Text="安装/修复" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Padding="14" Style="{StaticResource AudioCardStyle}">
                        <StackPanel Spacing="11">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontSize="19" Foreground="#30363D" />
                                <TextBlock Text="最近日志" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AudioTextBrush}" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{StaticResource AudioStrokeBrush}" />
                            <StackPanel x:Name="RecentAudioLogStackPanel" MinHeight="128" Spacing="8" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CopyAudioLogButton" Click="CopyLogButton_Click" Style="{StaticResource AudioOutlineButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="#30363D" />
                                        <TextBlock Text="复制" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ViewAudioLogButton" Grid.Column="1" Click="ShowLogsButton_Click" Style="{StaticResource AudioOutlineButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="16" Foreground="#30363D" />
                                        <TextBlock Text="查看" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
