<UserControl
    x:Class="SideDock.Host.App.StaticDiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="DiagPageBackgroundBrush" Color="#F6F8FA" />
        <SolidColorBrush x:Key="DiagCardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DiagStrokeBrush" Color="#D8DEE4" />
        <SolidColorBrush x:Key="DiagSoftStrokeBrush" Color="#E7EBEF" />
        <SolidColorBrush x:Key="DiagTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="DiagBodyBrush" Color="#30363D" />
        <SolidColorBrush x:Key="DiagMutedBrush" Color="#66717D" />
        <SolidColorBrush x:Key="DiagPrimaryBrush" Color="#087C89" />
        <SolidColorBrush x:Key="DiagPrimarySoftBrush" Color="#E7F4F5" />
        <SolidColorBrush x:Key="DiagBlueBrush" Color="#1267D8" />
        <SolidColorBrush x:Key="DiagBlueSoftBrush" Color="#EAF4FF" />
        <SolidColorBrush x:Key="DiagGreenBrush" Color="#238A25" />
        <SolidColorBrush x:Key="DiagGreenSoftBrush" Color="#ECFAE8" />
        <SolidColorBrush x:Key="DiagOrangeBrush" Color="#B86B00" />
        <SolidColorBrush x:Key="DiagRedBrush" Color="#C6281D" />
        <SolidColorBrush x:Key="DiagPurpleBrush" Color="#5363E6" />
        <SolidColorBrush x:Key="DiagPurpleSoftBrush" Color="#EEF0FF" />

        <Style x:Key="DiagCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{StaticResource DiagCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DiagStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DiagOutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource DiagStrokeBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DiagTextBrush}" />
        </Style>

        <Style x:Key="DiagIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource DiagPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="28,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="诊断"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource DiagTextBrush}" />

            <Button
                Grid.Column="1"
                Margin="36,0,0,0"
                MinWidth="170"
                Height="48"
                Padding="22,0"
                CornerRadius="7"
                Background="{StaticResource DiagPrimaryBrush}"
                BorderBrush="{StaticResource DiagPrimaryBrush}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE768;" FontSize="17" Foreground="White" />
                    <TextBlock
                        Text="启动主机"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White" />
                </StackPanel>
            </Button>

            <StackPanel
                Grid.Column="3"
                Orientation="Horizontal"
                Spacing="28"
                VerticalAlignment="Center">
                <Button Style="{StaticResource DiagIconButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="20" Foreground="#30363D" />
                        <TextBlock Text="刷新" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                    </StackPanel>
                </Button>
                <Button
                    MinWidth="96"
                    Height="38"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="#30363D" />
                        <TextBlock Text="操作" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                        <FontIcon Glyph="&#xE70D;" FontSize="12" Foreground="#30363D" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="28,0,28,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <Grid RowSpacing="14" Margin="0,0,0,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="96" />
                    <RowDefinition Height="118" />
                    <RowDefinition Height="520" />
                    <RowDefinition Height="250" />
                </Grid.RowDefinitions>

                <Border
                    Style="{StaticResource DiagCardStyle}"
                    Padding="22,0">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="#747B86">
                            <FontIcon Glyph="&#xE711;" FontSize="22" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                Text="等待 Android 设备"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#66717D" />
                            <TextBlock
                                Text="检测到 2 台 Android 设备，请选择后启动。"
                                FontSize="13"
                                Foreground="#66717D" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0">
                            <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#30363D" />
                        </Button>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Style="{StaticResource DiagCardStyle}"
                    Padding="24,0">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="52"
                            Height="52"
                            CornerRadius="26"
                            Background="{StaticResource DiagPrimaryBrush}">
                            <FontIcon Glyph="&#xE9D9;" FontSize="26" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <TextBlock
                                Text="详细诊断"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DiagTextBrush}" />
                            <TextBlock
                                Text="详细诊断区域已打开。运行指标、视频链路、虚拟显示器、摄像头、音频和日志可从诊断详情中查看与复制。"
                                FontSize="13"
                                Foreground="{StaticResource DiagBodyBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DiagCardStyle}" Padding="22,0">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="66"
                                Height="68"
                                CornerRadius="8"
                                Background="{StaticResource DiagGreenSoftBrush}">
                                <FontIcon Glyph="&#xE8EA;" FontSize="33" Foreground="{StaticResource DiagGreenBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="Android 设备" FontSize="13" Foreground="#30363D" />
                                <TextBlock Text="需选择设备" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DiagOrangeBrush}" />
                                <TextBlock Text="检测到 2 台已授权设备" FontSize="12" Foreground="#30363D" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DiagCardStyle}" Padding="22,0">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="66"
                                Height="68"
                                CornerRadius="8"
                                Background="#EEF5FF">
                                <FontIcon Glyph="&#xE713;" FontSize="33" Foreground="{StaticResource DiagBlueBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="主机服务" FontSize="13" Foreground="#30363D" />
                                <TextBlock Text="未启动" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DiagRedBrush}" />
                                <TextBlock Text="等待启动" FontSize="12" Foreground="#30363D" />
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="9" Height="9" Fill="#AEB6C0" VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DiagCardStyle}" Padding="22,0">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="66"
                                Height="68"
                                CornerRadius="8"
                                Background="{StaticResource DiagBlueSoftBrush}">
                                <FontIcon Glyph="&#xE714;" FontSize="33" Foreground="{StaticResource DiagBlueBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="视频链路" FontSize="13" Foreground="#30363D" />
                                <TextBlock Text="720p 120 fps" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource DiagBlueBrush}" />
                                <TextBlock Text="H.264 · 20 Mbps" FontSize="12" Foreground="#30363D" />
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="9" Height="9" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource DiagCardStyle}" Padding="22,0">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="66"
                                Height="68"
                                CornerRadius="8"
                                Background="{StaticResource DiagGreenSoftBrush}">
                                <FontIcon Glyph="&#xE916;" FontSize="33" Foreground="{StaticResource DiagGreenBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="端到端延迟" FontSize="13" Foreground="#30363D" />
                                <TextBlock Text="暂无数据" FontSize="22" FontWeight="SemiBold" Foreground="#66717D" />
                                <TextBlock Text="主机未运行" FontSize="12" Foreground="#30363D" />
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="9" Height="9" Fill="#AEB6C0" VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.75*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DiagCardStyle}" Padding="18">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Text="实时副屏预览"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DiagTextBrush}" />
                            <Border
                                Grid.Row="1"
                                CornerRadius="8"
                                Background="#08111F"
                                BorderBrush="#152235"
                                BorderThickness="1">
                                <Grid>
                                    <Border
                                        Width="98"
                                        Height="36"
                                        Margin="30,20,0,0"
                                        Padding="12,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        CornerRadius="7"
                                        Background="#101A2A">
                                        <TextBlock
                                            Text="主机未启动"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#DFE6EE" />
                                    </Border>

                                    <StackPanel
                                        Margin="0,20,18,0"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top">
                                        <Button Style="{StaticResource DiagOutlineButtonStyle}" Width="46" Padding="0" Background="#0E1828" BorderBrush="#293449">
                                            <FontIcon Glyph="&#xE740;" FontSize="18" Foreground="#DFE6EE" />
                                        </Button>
                                        <Button Style="{StaticResource DiagOutlineButtonStyle}" Width="46" Padding="0" Background="#0E1828" BorderBrush="#293449">
                                            <FontIcon Glyph="&#xE890;" FontSize="18" Foreground="#DFE6EE" />
                                        </Button>
                                        <Button Style="{StaticResource DiagOutlineButtonStyle}" Width="46" Padding="0" Background="#0E1828" BorderBrush="#293449">
                                            <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="#DFE6EE" />
                                        </Button>
                                    </StackPanel>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="42" Foreground="#6FD4FF" />
                                        <TextBlock
                                            Text="启动主机后显示副屏实时画面"
                                            FontSize="16"
                                            Foreground="#DFE6EE"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DiagCardStyle}" Padding="20,18">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="连接向导" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DiagTextBrush}" />
                                <Button Grid.Column="1" Style="{StaticResource DiagOutlineButtonStyle}" Height="38">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE90F;" FontSize="17" Foreground="#30363D" />
                                        <TextBlock Text="修复端点" VerticalAlignment="Center" FontSize="13" Foreground="#30363D" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Rectangle Grid.Row="1" Fill="{StaticResource DiagSoftStrokeBrush}" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="86" />
                                    <RowDefinition Height="86" />
                                    <RowDefinition Height="86" />
                                    <RowDefinition Height="86" />
                                </Grid.RowDefinitions>

                                <Rectangle
                                    Grid.RowSpan="4"
                                    Width="1"
                                    Fill="#CDD6DF"
                                    HorizontalAlignment="Center"
                                    Margin="0,42,0,42" />

                                <Border
                                    Width="38"
                                    Height="38"
                                    CornerRadius="19"
                                    Background="#FFF8EC"
                                    BorderBrush="#F5A623"
                                    BorderThickness="1">
                                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#B86B00" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="选择设备" FontSize="15" FontWeight="SemiBold" Foreground="#30363D" />
                                    <TextBlock Text="检测到 2 台设备，请选择一台" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagOrangeBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE7BA;" FontSize="18" Foreground="{StaticResource DiagOrangeBrush}" VerticalAlignment="Center" />

                                <Border Grid.Row="1" Width="38" Height="38" CornerRadius="19" Background="#F3F6FA" BorderBrush="#D8DEE4" BorderThickness="1">
                                    <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#66717D" />
                                </Border>
                                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="ADB reverse" FontSize="15" FontWeight="SemiBold" Foreground="#30363D" />
                                    <TextBlock Text="随启动主机自动检查" FontSize="13" Foreground="#66717D" />
                                </StackPanel>
                                <FontIcon Grid.Row="1" Grid.Column="2" Glyph="&#xE711;" FontSize="16" Foreground="#66717D" VerticalAlignment="Center" />

                                <Border Grid.Row="2" Width="38" Height="38" CornerRadius="19" Background="#F3F6FA" BorderBrush="#D8DEE4" BorderThickness="1">
                                    <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#66717D" />
                                </Border>
                                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="启动服务" FontSize="15" FontWeight="SemiBold" Foreground="#30363D" />
                                    <TextBlock Text="等待启动主机" FontSize="13" Foreground="#66717D" />
                                </StackPanel>
                                <FontIcon Grid.Row="2" Grid.Column="2" Glyph="&#xE711;" FontSize="16" Foreground="#66717D" VerticalAlignment="Center" />

                                <Border Grid.Row="3" Width="38" Height="38" CornerRadius="19" Background="#F3F6FA" BorderBrush="#D8DEE4" BorderThickness="1">
                                    <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#66717D" />
                                </Border>
                                <StackPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="连接链路" FontSize="15" FontWeight="SemiBold" Foreground="#30363D" />
                                    <TextBlock Text="等待主机运行" FontSize="13" Foreground="#66717D" />
                                </StackPanel>
                                <FontIcon Grid.Row="3" Grid.Column="2" Glyph="&#xE711;" FontSize="16" Foreground="#66717D" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    IsEnabled="False"
                                    MinWidth="132"
                                    Height="44"
                                    Padding="18,0"
                                    CornerRadius="7"
                                    Background="#F4F6F8"
                                    BorderBrush="#E1E6EA">
                                    <TextBlock Text="断开连接" FontSize="14" />
                                </Button>
                                <Button Grid.Column="2" Width="56" Height="44" Padding="0" CornerRadius="7" Background="#FFFFFF" BorderBrush="{StaticResource DiagSoftStrokeBrush}">
                                    <FontIcon Glyph="&#xE712;" FontSize="20" Foreground="#30363D" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="4" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.18*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DiagCardStyle}" Padding="16">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource DiagPrimaryBrush}">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="27" Foreground="White" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="虚拟显示器" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DiagTextBrush}" />
                                <ToggleSwitch Grid.Column="2" IsOn="False" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="状态" FontSize="13" Foreground="#30363D" />
                                <TextBlock Grid.Column="1" Text="未运行" HorizontalAlignment="Right" FontSize="13" Foreground="#66717D" />
                                <TextBlock Grid.Row="1" Text="分辨率" FontSize="13" Foreground="#30363D" />
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" Height="34">
                                    <ComboBoxItem Content="720p" />
                                </ComboBox>
                                <TextBlock Grid.Row="2" Text="帧率" FontSize="13" Foreground="#30363D" />
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" Height="34">
                                    <ComboBoxItem Content="120" />
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Row="2" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Height="34" Padding="8,0" Background="#FFFFFF" BorderBrush="{StaticResource DiagStrokeBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE896;" FontSize="15" />
                                        <TextBlock Text="安装/修复" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Height="34" Padding="8,0" Background="#FFFFFF" BorderBrush="{StaticResource DiagStrokeBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                                        <TextBlock Text="显示设置" FontSize="13" />
                                        <FontIcon Glyph="&#xE72A;" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DiagCardStyle}" Padding="16">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="26" Background="#5CB7F0">
                                    <FontIcon Glyph="&#xE722;" FontSize="27" Foreground="White" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="摄像头" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DiagTextBrush}" />
                                <ToggleSwitch Grid.Column="2" IsOn="True" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="状态" FontSize="13" Foreground="#30363D" />
                                <TextBlock Grid.Column="1" Text="未启动" HorizontalAlignment="Right" FontSize="13" Foreground="#66717D" />
                                <TextBlock Grid.Row="1" Text="分辨率" FontSize="13" Foreground="#30363D" />
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" Height="34">
                                    <ComboBoxItem Content="720p" />
                                </ComboBox>
                                <TextBlock Grid.Row="2" Text="帧率" FontSize="13" Foreground="#30363D" />
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" Height="34">
                                    <ComboBoxItem Content="30" />
                                </ComboBox>
                            </Grid>
                            <Button Grid.Row="2" Height="34" Padding="10,0" HorizontalAlignment="Left" Background="#FFFFFF" BorderBrush="{StaticResource DiagStrokeBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                                    <TextBlock Text="摄像头设置" FontSize="13" />
                                    <FontIcon Glyph="&#xE72A;" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DiagCardStyle}" Padding="16">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource DiagPurpleBrush}">
                                    <FontIcon Glyph="&#xE995;" FontSize="27" Foreground="White" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="音频桥接" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DiagTextBrush}" />
                                <ToggleSwitch Grid.Column="2" IsOn="True" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="状态" FontSize="13" Foreground="#30363D" />
                                <TextBlock Grid.Column="1" Text="等待 Android 设备" HorizontalAlignment="Right" FontSize="13" Foreground="#66717D" />
                                <TextBlock Grid.Row="1" Text="模式" FontSize="13" Foreground="#30363D" />
                                <Grid Grid.Row="1" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="34" CornerRadius="6,0,0,6" Background="{StaticResource DiagPrimaryBrush}">
                                        <TextBlock Text="立体声" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <Border Grid.Column="1" Height="34" CornerRadius="0,6,6,0" Background="#F3F6FA" BorderBrush="{StaticResource DiagStrokeBrush}" BorderThickness="1">
                                        <TextBlock Text="环绕声" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#A2ABB5" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="2" Text="采样率" FontSize="13" Foreground="#30363D" />
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="34" CornerRadius="6,0,0,6" Background="{StaticResource DiagPrimaryBrush}">
                                        <TextBlock Text="48 kHz" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <Border Grid.Column="1" Height="34" CornerRadius="0,6,6,0" Background="#F3F6FA" BorderBrush="{StaticResource DiagStrokeBrush}" BorderThickness="1">
                                        <TextBlock Text="96 kHz" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#A2ABB5" />
                                    </Border>
                                </Grid>
                            </Grid>
                            <Button Grid.Row="2" Height="34" Padding="10,0" HorizontalAlignment="Left" Background="#FFFFFF" BorderBrush="{StaticResource DiagStrokeBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                                    <TextBlock Text="音频设置" FontSize="13" />
                                    <FontIcon Glyph="&#xE72A;" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource DiagCardStyle}" Padding="16">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="26" Background="#55B9C2">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="27" Foreground="White" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="运行诊断" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DiagTextBrush}" />
                                <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="18" Foreground="#30363D" />
                            </Grid>
                            <Grid Grid.Row="1" RowSpacing="7" ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CPU" FontSize="13" Foreground="#30363D" />
                                <TextBlock Grid.Column="1" Text="未运行" FontSize="13" Foreground="#66717D" />
                                <TextBlock Grid.Column="2" Text="▪▪▪▪▪▪▪▪▪▪" FontSize="15" Foreground="#D8DEE4" />
                                <TextBlock Grid.Row="1" Text="内存" FontSize="13" Foreground="#30363D" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="未运行" FontSize="13" Foreground="#66717D" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="▪▪▪▪▪▪▪▪" FontSize="15" Foreground="#D8DEE4" />
                                <TextBlock Grid.Row="2" Text="网络" FontSize="13" Foreground="#30363D" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="" FontSize="13" />
                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEC3F;" FontSize="17" Foreground="{StaticResource DiagPrimaryBrush}" />
                                    <TextBlock Text="链路 325 Mbps" FontSize="13" Foreground="{StaticResource DiagPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="丢包/丢帧无数据" FontSize="13" Foreground="#30363D" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <TextBlock Text="查看详细诊断" FontSize="13" Foreground="#30363D" />
                                <FontIcon Glyph="&#xE72A;" FontSize="14" Foreground="#30363D" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
