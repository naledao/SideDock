<UserControl
    x:Class="SideDock.Host.App.StaticDiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="DiagPageBackgroundBrush" Color="#F6F8FA" />
        <SolidColorBrush x:Key="DiagCardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DiagStrokeBrush" Color="#D8DEE4" />
        <SolidColorBrush x:Key="DiagSoftStrokeBrush" Color="#E7EBEF" />
        <SolidColorBrush x:Key="DiagTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="DiagBodyBrush" Color="#30363D" />
        <SolidColorBrush x:Key="DiagMutedBrush" Color="#66717D" />
        <SolidColorBrush x:Key="DiagPrimaryBrush" Color="#087C89" />
        <SolidColorBrush x:Key="DiagGreenBrush" Color="#168A1A" />
        <SolidColorBrush x:Key="DiagGreenSoftBrush" Color="#F2FFF0" />
        <SolidColorBrush x:Key="DiagBlueBrush" Color="#1267D8" />
        <SolidColorBrush x:Key="DiagBlueSoftBrush" Color="#EAF4FF" />
        <SolidColorBrush x:Key="DiagPurpleBrush" Color="#4C3DB3" />
        <SolidColorBrush x:Key="DiagPurpleSoftBrush" Color="#F0EEFF" />
        <SolidColorBrush x:Key="DiagOrangeBrush" Color="#D77800" />
        <SolidColorBrush x:Key="DiagOrangeSoftBrush" Color="#FFF4E5" />

        <Style x:Key="DiagCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{StaticResource DiagCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DiagStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DiagHeaderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource DiagStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DiagSmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource DiagStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource DiagPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="28,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="诊断"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource DiagTextBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <Button
                    x:Name="CopyAllDiagnosticsButton"
                    Style="{StaticResource DiagHeaderButtonStyle}"
                    Click="CopyAllDiagnosticsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8C8;" FontSize="17" Foreground="#30363D" />
                        <TextBlock Text="复制全部" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource DiagBodyBrush}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ExportLogsButton"
                    Style="{StaticResource DiagHeaderButtonStyle}"
                    MinWidth="126"
                    Click="ExportLogsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE898;" FontSize="17" Foreground="#30363D" />
                        <TextBlock Text="导出日志" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource DiagBodyBrush}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="RefreshDiagnosticsButton"
                    Style="{StaticResource DiagHeaderButtonStyle}"
                    Click="RefreshDiagnosticsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE72C;" FontSize="18" Foreground="#30363D" />
                        <TextBlock Text="刷新" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource DiagBodyBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="28,0,28,22"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="106" />
                    <RowDefinition Height="402" />
                    <RowDefinition Height="236" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="OverallStatusBanner"
                    Style="{StaticResource DiagCardStyle}"
                    Padding="16,0"
                    Background="{StaticResource DiagGreenSoftBrush}"
                    BorderBrush="#78BD78">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="OverallStatusIconBackground"
                            Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="{StaticResource DiagGreenBrush}">
                            <FontIcon x:Name="OverallStatusIcon" Glyph="&#xE73E;" FontSize="22" Foreground="#FFFFFF" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="OverallStatusTitleText" Text="运行诊断正常" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" />
                            <TextBlock x:Name="OverallStatusDetailText" Text="所有关键服务运行正常，系统性能良好。" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE711;" FontSize="14" Foreground="#30363D" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DiagCardStyle}" Padding="14,0">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="58" Height="60" CornerRadius="8" Background="{StaticResource DiagBlueSoftBrush}">
                                <FontIcon Glyph="&#xE7F4;" FontSize="31" Foreground="{StaticResource DiagBlueBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="Host" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HostStatusValueText" Text="运行中" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HostStatusDetailText" Text="正常运行 01:24:36" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Ellipse x:Name="HostStatusDot" Grid.Column="2" Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Top" Margin="0,18,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DiagCardStyle}" Padding="14,0">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="58" Height="60" CornerRadius="8" Background="#EEF9ED">
                                <FontIcon Glyph="&#xE71B;" FontSize="31" Foreground="{StaticResource DiagGreenBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="ADB reverse" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="AdbReverseStatusValueText" Text="正常" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="AdbReverseStatusDetailText" Text="4 个端口已映射" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Ellipse x:Name="AdbReverseStatusDot" Grid.Column="2" Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Top" Margin="0,18,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DiagCardStyle}" Padding="14,0">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="58" Height="60" CornerRadius="8" Background="{StaticResource DiagPurpleSoftBrush}">
                                <FontIcon Glyph="&#xE9D2;" FontSize="32" Foreground="{StaticResource DiagPurpleBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="丢帧/丢包率" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PacketLossValueText" Text="0.0%" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PacketLossDetailText" Text="良好" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Ellipse x:Name="PacketLossStatusDot" Grid.Column="2" Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Top" Margin="0,18,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource DiagCardStyle}" Padding="14,0">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="58" Height="60" CornerRadius="8" Background="{StaticResource DiagOrangeSoftBrush}">
                                <FontIcon Glyph="&#xE916;" FontSize="32" Foreground="{StaticResource DiagOrangeBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="延迟" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LatencyValueText" Text="22 ms" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LatencyDetailText" Text="优秀" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Ellipse x:Name="LatencyStatusDot" Grid.Column="2" Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Top" Margin="0,18,0,0" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.78*" />
                        <ColumnDefinition Width="0.88*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DiagCardStyle}" Padding="16">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="实时日志" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DiagTextBrush}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="自动滚动" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" VerticalAlignment="Center" />
                                    <ToggleSwitch
                                        x:Name="DiagnosticsAutoScrollSwitch"
                                        IsOn="True"
                                        MinWidth="56"
                                        OnContent=""
                                        OffContent=""
                                        Toggled="DiagnosticsAutoScrollSwitch_Toggled" />
                                    <Button
                                        x:Name="ClearDiagnosticsLogsButton"
                                        Style="{StaticResource DiagSmallButtonStyle}"
                                        MinWidth="52"
                                        Click="ClearDiagnosticsLogsButton_Click">
                                        <TextBlock Text="清空" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button
                                        x:Name="LogFilterAllButton"
                                        Width="60"
                                        Height="30"
                                        Padding="0"
                                        CornerRadius="5,0,0,5"
                                        Tag="All"
                                        Click="LogFilterButton_Click">
                                        <TextBlock Text="全部" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                    </Button>
                                    <Button
                                        x:Name="LogFilterHostButton"
                                        Width="60"
                                        Height="30"
                                        Padding="0"
                                        CornerRadius="0"
                                        Tag="Host"
                                        Click="LogFilterButton_Click">
                                        <TextBlock Text="Host" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                    </Button>
                                    <Button
                                        x:Name="LogFilterAdbButton"
                                        Width="60"
                                        Height="30"
                                        Padding="0"
                                        CornerRadius="0"
                                        Tag="Adb"
                                        Click="LogFilterButton_Click">
                                        <TextBlock Text="ADB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                    </Button>
                                    <Button
                                        x:Name="LogFilterCameraButton"
                                        Width="70"
                                        Height="30"
                                        Padding="0"
                                        CornerRadius="0"
                                        Tag="Camera"
                                        Click="LogFilterButton_Click">
                                        <TextBlock Text="摄像头" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                    </Button>
                                    <Button
                                        x:Name="LogFilterAudioButton"
                                        Width="60"
                                        Height="30"
                                        Padding="0"
                                        CornerRadius="0,5,5,0"
                                        Tag="Audio"
                                        Click="LogFilterButton_Click">
                                        <TextBlock Text="音频" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                    </Button>
                                </StackPanel>

                                <Border Grid.Row="1" CornerRadius="6" BorderBrush="{StaticResource DiagStrokeBrush}" BorderThickness="1" Background="#FBFCFD" Padding="14,10">
                                    <Grid>
                                        <ScrollViewer
                                            x:Name="DiagnosticsLogScrollViewer"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="DiagnosticsLogPanel" Spacing="0" />
                                        </ScrollViewer>
                                        <TextBlock
                                            x:Name="DiagnosticsLogEmptyText"
                                            Text="Host 未启动，暂无实时日志。"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{StaticResource DiagMutedBrush}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DiagCardStyle}" Padding="16">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="健康检查" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DiagTextBrush}" />
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="48" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE83D;" FontSize="21" Foreground="{StaticResource DiagBodyBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="Android 授权" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AndroidAuthDetailText" Text="设备已授权" FontSize="12" Foreground="{StaticResource DiagMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="AndroidAuthStatusText" Grid.Column="2" Text="正常" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                <FontIcon x:Name="AndroidAuthStatusIcon" Grid.Column="3" Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />

                                <Border Grid.Row="1" Grid.ColumnSpan="4" Height="1" Background="{StaticResource DiagSoftStrokeBrush}" VerticalAlignment="Top" />
                                <FontIcon Grid.Row="1" Glyph="&#xE7F4;" FontSize="21" Foreground="{StaticResource DiagBodyBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="端口监听" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PortListeningDetailText" Text="4/4 端口正常监听" FontSize="12" Foreground="{StaticResource DiagMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="PortListeningStatusText" Grid.Row="1" Grid.Column="2" Text="正常" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                <FontIcon x:Name="PortListeningStatusIcon" Grid.Row="1" Grid.Column="3" Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />

                                <Border Grid.Row="2" Grid.ColumnSpan="4" Height="1" Background="{StaticResource DiagSoftStrokeBrush}" VerticalAlignment="Top" />
                                <FontIcon Grid.Row="2" Glyph="&#xE71B;" FontSize="21" Foreground="{StaticResource DiagBodyBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="ADB reverse" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AdbReverseHealthDetailText" Text="4/4 端口已映射" FontSize="12" Foreground="{StaticResource DiagMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="AdbReverseHealthStatusText" Grid.Row="2" Grid.Column="2" Text="正常" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                <FontIcon x:Name="AdbReverseHealthStatusIcon" Grid.Row="2" Grid.Column="3" Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />

                                <Border Grid.Row="3" Grid.ColumnSpan="4" Height="1" Background="{StaticResource DiagSoftStrokeBrush}" VerticalAlignment="Top" />
                                <FontIcon Grid.Row="3" Glyph="&#xE7F4;" FontSize="21" Foreground="{StaticResource DiagBodyBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="虚拟显示器" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="VirtualDisplayDetailText" Text="1920 x 1080 @ 120 Hz" FontSize="12" Foreground="{StaticResource DiagMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="VirtualDisplayStatusText" Grid.Row="3" Grid.Column="2" Text="正常" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                <FontIcon x:Name="VirtualDisplayStatusIcon" Grid.Row="3" Grid.Column="3" Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />

                                <Border Grid.Row="4" Grid.ColumnSpan="4" Height="1" Background="{StaticResource DiagSoftStrokeBrush}" VerticalAlignment="Top" />
                                <FontIcon Grid.Row="4" Glyph="&#xE722;" FontSize="21" Foreground="{StaticResource DiagBodyBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="虚拟相机" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="VirtualCameraDetailText" Text="1280 x 720 @ 30 fps" FontSize="12" Foreground="{StaticResource DiagMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="VirtualCameraStatusText" Grid.Row="4" Grid.Column="2" Text="正常" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                <FontIcon x:Name="VirtualCameraStatusIcon" Grid.Row="4" Grid.Column="3" Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />

                                <Border Grid.Row="5" Grid.ColumnSpan="4" Height="1" Background="{StaticResource DiagSoftStrokeBrush}" VerticalAlignment="Top" />
                                <FontIcon Grid.Row="5" Glyph="&#xE995;" FontSize="21" Foreground="{StaticResource DiagBodyBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="音频端点" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AudioEndpointDetailText" Text="播放和录音端点检查" FontSize="12" Foreground="{StaticResource DiagMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="AudioEndpointStatusText" Grid.Row="5" Grid.Column="2" Text="警告" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagOrangeBrush}" VerticalAlignment="Center" />
                                <FontIcon x:Name="AudioEndpointStatusIcon" Grid.Row="5" Grid.Column="3" Glyph="&#xE7BA;" FontSize="15" Foreground="{StaticResource DiagOrangeBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Button
                                x:Name="RecheckDiagnosticsButton"
                                Grid.Row="2"
                                Style="{StaticResource DiagSmallButtonStyle}"
                                Click="RecheckDiagnosticsButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="{StaticResource DiagBodyBrush}" />
                                    <TextBlock Text="重新检查" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.28*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.92*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DiagCardStyle}" Padding="16">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="性能趋势" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DiagTextBrush}" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="0">
                                    <Button
                                        x:Name="TrendRangeOneMinuteButton"
                                        Width="58"
                                        Height="28"
                                        Padding="0"
                                        CornerRadius="5,0,0,5"
                                        Tag="OneMinute"
                                        Click="TrendRangeButton_Click">
                                        <TextBlock Text="1 分钟" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                    </Button>
                                    <Button
                                        x:Name="TrendRangeFiveMinutesButton"
                                        Width="58"
                                        Height="28"
                                        Padding="0"
                                        CornerRadius="0"
                                        Tag="FiveMinutes"
                                        Click="TrendRangeButton_Click">
                                        <TextBlock Text="5 分钟" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                    </Button>
                                    <Button
                                        x:Name="TrendRangeFifteenMinutesButton"
                                        Width="58"
                                        Height="28"
                                        Padding="0"
                                        CornerRadius="0,5,5,0"
                                        Tag="FifteenMinutes"
                                        Click="TrendRangeButton_Click">
                                        <TextBlock Text="15 分钟" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Rectangle Width="16" Height="3" Fill="#0FA3B1" RadiusX="1" RadiusY="1" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TrendCpuValueText" Text="CPU --" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Rectangle Width="16" Height="3" Fill="#2E6DEB" RadiusX="1" RadiusY="1" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TrendMemoryValueText" Text="内存 --" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Rectangle Width="16" Height="3" Fill="#4AAE52" RadiusX="1" RadiusY="1" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TrendNetworkValueText" Text="网络 -- Mbps" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="100%" FontSize="11" Foreground="{StaticResource DiagMutedBrush}" />
                                    <TextBlock Grid.Row="1" Text="50%" FontSize="11" Foreground="{StaticResource DiagMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="0%" FontSize="11" Foreground="{StaticResource DiagMutedBrush}" VerticalAlignment="Bottom" />
                                    <TextBlock x:Name="TrendRightTopLabel" Grid.Column="2" Text="100" FontSize="11" Foreground="{StaticResource DiagMutedBrush}" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="TrendRightMiddleLabel" Grid.Row="1" Grid.Column="2" Text="50" FontSize="11" Foreground="{StaticResource DiagMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TrendRightBottomLabel" Grid.Row="2" Grid.Column="2" Text="0" FontSize="11" Foreground="{StaticResource DiagMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                                    <Grid Grid.Column="1" Grid.RowSpan="3" Margin="4,6,4,12">
                                        <Canvas x:Name="DiagnosticsTrendCanvas" SizeChanged="DiagnosticsTrendCanvas_SizeChanged" />
                                        <TextBlock
                                            x:Name="DiagnosticsTrendEmptyText"
                                            Text="Host 未运行，暂无性能数据。"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{StaticResource DiagMutedBrush}" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2">
                                <TextBlock x:Name="TrendStartTimeText" Text="--:--:--" FontSize="11" Foreground="{StaticResource DiagMutedBrush}" />
                                <TextBlock x:Name="TrendScaleHintText" Text="内存按当前范围工作集峰值缩放" FontSize="11" Foreground="{StaticResource DiagMutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TrendEndTimeText" Text="--:--:--" FontSize="11" Foreground="{StaticResource DiagMutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DiagCardStyle}" Padding="16">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="端口映射" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DiagTextBrush}" />
                            <Grid Grid.Row="1" RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="端口" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                <TextBlock Grid.Column="1" Text="用途" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                <TextBlock Grid.Column="2" Text="本地状态" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                <TextBlock Grid.Column="3" Text="映射状态" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />

                                <TextBlock Grid.Row="1" Text="27183" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="控制" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="监听中" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="已映射" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="27184" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="视频" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="监听中" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="已映射" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Text="27185" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="音频" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="监听中" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="已映射" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Row="4" Text="27186" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="摄像头" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="监听中" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="已映射" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2">
                                <TextBlock Text="查看完整端口信息" FontSize="13" Foreground="{StaticResource DiagPrimaryBrush}" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE72A;" FontSize="14" Foreground="{StaticResource DiagBodyBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DiagCardStyle}" Padding="16">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="最近错误" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DiagTextBrush}" />
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <Border Width="58" Height="58" CornerRadius="29" BorderBrush="{StaticResource DiagGreenBrush}" BorderThickness="3">
                                    <FontIcon Glyph="&#xE73E;" FontSize="29" Foreground="{StaticResource DiagGreenBrush}" />
                                </Border>
                                <TextBlock Text="无严重错误" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" />
                                <TextBlock Text="最近 24 小时内未检测到严重错误。" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Border Height="1" Background="{StaticResource DiagSoftStrokeBrush}" VerticalAlignment="Top" />
                                <TextBlock Text="查看错误历史" FontSize="13" Foreground="{StaticResource DiagPrimaryBrush}" VerticalAlignment="Bottom" />
