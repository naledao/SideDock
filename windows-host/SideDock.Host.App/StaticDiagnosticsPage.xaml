<UserControl
    x:Class="SideDock.Host.App.StaticDiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="DiagPageBackgroundBrush" Color="#F6F8FA" />
        <SolidColorBrush x:Key="DiagCardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DiagStrokeBrush" Color="#D8DEE4" />
        <SolidColorBrush x:Key="DiagSoftStrokeBrush" Color="#E7EBEF" />
        <SolidColorBrush x:Key="DiagTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="DiagBodyBrush" Color="#30363D" />
        <SolidColorBrush x:Key="DiagMutedBrush" Color="#66717D" />
        <SolidColorBrush x:Key="DiagPrimaryBrush" Color="#087C89" />
        <SolidColorBrush x:Key="DiagGreenBrush" Color="#168A1A" />
        <SolidColorBrush x:Key="DiagGreenSoftBrush" Color="#F2FFF0" />
        <SolidColorBrush x:Key="DiagBlueBrush" Color="#1267D8" />
        <SolidColorBrush x:Key="DiagBlueSoftBrush" Color="#EAF4FF" />
        <SolidColorBrush x:Key="DiagPurpleBrush" Color="#4C3DB3" />
        <SolidColorBrush x:Key="DiagPurpleSoftBrush" Color="#F0EEFF" />
        <SolidColorBrush x:Key="DiagOrangeBrush" Color="#D77800" />
        <SolidColorBrush x:Key="DiagOrangeSoftBrush" Color="#FFF4E5" />

        <Style x:Key="DiagCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{StaticResource DiagCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DiagStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DiagHeaderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource DiagStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DiagSmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource DiagStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource DiagPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="28,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="诊断"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource DiagTextBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <Button Style="{StaticResource DiagHeaderButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8C8;" FontSize="17" Foreground="#30363D" />
                        <TextBlock Text="复制全部" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource DiagBodyBrush}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DiagHeaderButtonStyle}" MinWidth="126">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE898;" FontSize="17" Foreground="#30363D" />
                        <TextBlock Text="导出日志" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource DiagBodyBrush}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DiagHeaderButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE72C;" FontSize="18" Foreground="#30363D" />
                        <TextBlock Text="刷新" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource DiagBodyBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="28,0,28,22"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="106" />
                    <RowDefinition Height="402" />
                    <RowDefinition Height="236" />
                </Grid.RowDefinitions>

                <Border
                    Style="{StaticResource DiagCardStyle}"
                    Padding="16,0"
                    Background="{StaticResource DiagGreenSoftBrush}"
                    BorderBrush="#78BD78">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource DiagGreenBrush}">
                            <FontIcon Glyph="&#xE73E;" FontSize="22" Foreground="#FFFFFF" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="运行诊断正常" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" />
                            <TextBlock Text="所有关键服务运行正常，系统性能良好。" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE711;" FontSize="14" Foreground="#30363D" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DiagCardStyle}" Padding="14,0">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="58" Height="60" CornerRadius="8" Background="{StaticResource DiagBlueSoftBrush}">
                                <FontIcon Glyph="&#xE7F4;" FontSize="31" Foreground="{StaticResource DiagBlueBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="Host" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="运行中" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="正常运行 01:24:36" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Top" Margin="0,18,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DiagCardStyle}" Padding="14,0">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="58" Height="60" CornerRadius="8" Background="#EEF9ED">
                                <FontIcon Glyph="&#xE71B;" FontSize="31" Foreground="{StaticResource DiagGreenBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="ADB reverse" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="正常" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="4 个端口已映射" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Top" Margin="0,18,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DiagCardStyle}" Padding="14,0">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="58" Height="60" CornerRadius="8" Background="{StaticResource DiagPurpleSoftBrush}">
                                <FontIcon Glyph="&#xE9D2;" FontSize="32" Foreground="{StaticResource DiagPurpleBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="丢包率" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="0.0%" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="良好" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Top" Margin="0,18,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource DiagCardStyle}" Padding="14,0">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="58" Height="60" CornerRadius="8" Background="{StaticResource DiagOrangeSoftBrush}">
                                <FontIcon Glyph="&#xE916;" FontSize="32" Foreground="{StaticResource DiagOrangeBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="延迟" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="22 ms" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="优秀" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{StaticResource DiagGreenBrush}" VerticalAlignment="Top" Margin="0,18,0,0" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.78*" />
                        <ColumnDefinition Width="0.88*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DiagCardStyle}" Padding="16">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="实时日志" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DiagTextBrush}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="自动滚动" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" VerticalAlignment="Center" />
                                    <Border Width="42" Height="22" CornerRadius="11" Background="{StaticResource DiagPrimaryBrush}">
                                        <Ellipse Width="16" Height="16" Margin="22,0,4,0" Fill="#FFFFFF" />
                                    </Border>
                                    <Button Style="{StaticResource DiagSmallButtonStyle}" Width="38" Padding="0">
                                        <FontIcon Glyph="&#xE71C;" FontSize="16" Foreground="#30363D" />
                                    </Button>
                                    <Button Style="{StaticResource DiagSmallButtonStyle}" MinWidth="52">
                                        <TextBlock Text="清空" FontSize="13" Foreground="{StaticResource DiagBodyBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Border Width="60" CornerRadius="5,0,0,5" Background="{StaticResource DiagPrimaryBrush}">
                                        <TextBlock Text="全部" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    </Border>
                                    <Border Width="60" BorderBrush="{StaticResource DiagStrokeBrush}" BorderThickness="1,1,0,1">
                                        <TextBlock Text="Host" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                    </Border>
                                    <Border Width="60" BorderBrush="{StaticResource DiagStrokeBrush}" BorderThickness="1,1,0,1">
                                        <TextBlock Text="ADB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                    </Border>
                                    <Border Width="70" BorderBrush="{StaticResource DiagStrokeBrush}" BorderThickness="1,1,0,1">
                                        <TextBlock Text="摄像头" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                    </Border>
                                    <Border Width="60" CornerRadius="0,5,5,0" BorderBrush="{StaticResource DiagStrokeBrush}" BorderThickness="1">
                                        <TextBlock Text="音频" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                    </Border>
                                </StackPanel>

                                <Border Grid.Row="1" CornerRadius="6" BorderBrush="{StaticResource DiagStrokeBrush}" BorderThickness="1" Background="#FBFCFD" Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="24" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="176" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="2025-05-26 10:42:18.123" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Column="1" Text="[INFO]" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagGreenBrush}" />
                                        <TextBlock Grid.Column="2" Text="Host" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Column="3" Text="Host service started, version 1.3.0" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="1" Text="2025-05-26 10:42:18.246" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="[INFO]" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagGreenBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Connect" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Device HA1K3AX0 connected via USB" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="2" Text="2025-05-26 10:42:18.512" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="[INFO]" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagGreenBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="ADB" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="ADB device authorized" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="3" Text="2025-05-26 10:42:18.784" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="[INFO]" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagGreenBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="ADB" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Reverse port forwarded: tcp:27183 -> tcp:27183" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="4" Text="2025-05-26 10:42:18.785" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="[INFO]" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagGreenBrush}" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="ADB" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="4" Grid.Column="3" Text="Reverse port forwarded: tcp:27184 -> tcp:27184" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="5" Text="2025-05-26 10:42:18.786" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="[INFO]" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagGreenBrush}" />
                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="ADB" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="5" Grid.Column="3" Text="Reverse port forwarded: tcp:27185 -> tcp:27185" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="6" Text="2025-05-26 10:42:18.787" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="[INFO]" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagGreenBrush}" />
                                        <TextBlock Grid.Row="6" Grid.Column="2" Text="ADB" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="6" Grid.Column="3" Text="Reverse port forwarded: tcp:27186 -> tcp:27186" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="7" Text="2025-05-26 10:42:19.102" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="[INFO]" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagGreenBrush}" />
                                        <TextBlock Grid.Row="7" Grid.Column="2" Text="Display" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="7" Grid.Column="3" Text="Virtual display started (1920x1080@120Hz)" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="8" Text="2025-05-26 10:42:19.135" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="[INFO]" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagGreenBrush}" />
                                        <TextBlock Grid.Row="8" Grid.Column="2" Text="Camera" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="8" Grid.Column="3" Text="Camera streaming started (1280x720@30fps)" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="9" Text="2025-05-26 10:42:21.543" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="9" Grid.Column="1" Text="[INFO]" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagGreenBrush}" />
                                        <TextBlock Grid.Row="9" Grid.Column="2" Text="Perf" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" />
                                        <TextBlock Grid.Row="9" Grid.Column="3" Text="avg_latency=22ms, fps=120, bitrate=20.3Mbps" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />

                                        <Rectangle Width="4" Height="210" Fill="#AEB6C0" RadiusX="2" RadiusY="2" HorizontalAlignment="Right" Margin="0,22,2,0" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DiagCardStyle}" Padding="16">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="健康检查" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DiagTextBrush}" />
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="48" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE83D;" FontSize="21" Foreground="{StaticResource DiagBodyBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="Android 授权" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="设备已授权" FontSize="12" Foreground="{StaticResource DiagMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="正常" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                <FontIcon Grid.Column="3" Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />

                                <Border Grid.Row="1" Grid.ColumnSpan="4" Height="1" Background="{StaticResource DiagSoftStrokeBrush}" VerticalAlignment="Top" />
                                <FontIcon Grid.Row="1" Glyph="&#xE7F4;" FontSize="21" Foreground="{StaticResource DiagBodyBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="端口监听" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="4/4 端口正常监听" FontSize="12" Foreground="{StaticResource DiagMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="正常" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                <FontIcon Grid.Row="1" Grid.Column="3" Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />

                                <Border Grid.Row="2" Grid.ColumnSpan="4" Height="1" Background="{StaticResource DiagSoftStrokeBrush}" VerticalAlignment="Top" />
                                <FontIcon Grid.Row="2" Glyph="&#xE71B;" FontSize="21" Foreground="{StaticResource DiagBodyBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="ADB reverse" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagBodyBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="4/4 端口已映射" FontSize="12" Foreground="{StaticResource DiagMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="正常" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />
                                <FontIcon Grid.Row="2" Grid.Column="3" Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource DiagGreenBrush}" VerticalAlignment="Center" />

                                <Border Grid.Row="3" Grid.ColumnSpan="4" Height="1" Background="{StaticResource DiagSoftStrokeBrush}" VerticalAlignment="Top" />
