<UserControl
    x:Class="SideDock.Host.App.StaticDisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SideDockPageBackgroundBrush" Color="#F6F8FA" />
        <SolidColorBrush x:Key="SideDockPanelBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SideDockStrokeBrush" Color="#D8DEE4" />
        <SolidColorBrush x:Key="SideDockTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="SideDockMutedTextBrush" Color="#5B6570" />
        <SolidColorBrush x:Key="SideDockPrimaryBrush" Color="#087C89" />
        <SolidColorBrush x:Key="SideDockSuccessBrush" Color="#238A25" />

        <Style x:Key="StaticCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{StaticResource SideDockPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SideDockStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="StaticOutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource SideDockStrokeBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SideDockTextBrush}" />
        </Style>

        <Style x:Key="StaticGhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource SideDockTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SideDockPageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Background="#F1F5F8"
            BorderBrush="#D4DCE3"
            BorderThickness="0,0,1,0">
            <Grid Padding="18,18,18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        Width="34"
                        Height="34"
                        CornerRadius="7"
                        Background="Transparent">
                        <Image Source="ms-appx:///Assets/SideDock.ico" Stretch="Uniform" />
                    </Border>
                    <TextBlock
                        Text="SideDock Host"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SideDockTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,36,0,0" Spacing="8">
                    <Button
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="总览">
                        <Border Height="44" Padding="14,0" CornerRadius="7">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="4" Height="26" CornerRadius="2" Background="{StaticResource SideDockPrimaryBrush}" Opacity="0" />
                                <FontIcon Grid.Column="1" Glyph="&#xE80F;" FontSize="18" Foreground="#30363D" />
                                <TextBlock Grid.Column="2" Text="总览" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="连接">
                        <Border Height="44" Padding="14,0" CornerRadius="7">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="4" Height="26" CornerRadius="2" Background="{StaticResource SideDockPrimaryBrush}" Opacity="0" />
                                <FontIcon Grid.Column="1" Glyph="&#xE71B;" FontSize="18" Foreground="#30363D" />
                                <TextBlock Grid.Column="2" Text="连接" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="虚拟显示器">
                        <Border Height="44" Padding="14,0" CornerRadius="7" Background="#E6EBEF">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="4" Height="26" CornerRadius="2" Background="{StaticResource SideDockPrimaryBrush}" />
                                <FontIcon Grid.Column="1" Glyph="&#xE7F4;" FontSize="18" Foreground="{StaticResource SideDockPrimaryBrush}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="虚拟显示器"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SideDockPrimaryBrush}" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="摄像头">
                        <Border Height="44" Padding="14,0" CornerRadius="7">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="4" Height="26" CornerRadius="2" Background="{StaticResource SideDockPrimaryBrush}" Opacity="0" />
                                <FontIcon Grid.Column="1" Glyph="&#xE722;" FontSize="18" Foreground="#30363D" />
                                <TextBlock Grid.Column="2" Text="摄像头" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="音频">
                        <Border Height="44" Padding="14,0" CornerRadius="7">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="4" Height="26" CornerRadius="2" Background="{StaticResource SideDockPrimaryBrush}" Opacity="0" />
                                <FontIcon Grid.Column="1" Glyph="&#xE995;" FontSize="18" Foreground="#30363D" />
                                <TextBlock Grid.Column="2" Text="音频" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="诊断">
                        <Border Height="44" Padding="14,0" CornerRadius="7">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="4" Height="26" CornerRadius="2" Background="{StaticResource SideDockPrimaryBrush}" Opacity="0" />
                                <FontIcon Grid.Column="1" Glyph="&#xE9D9;" FontSize="18" Foreground="#30363D" />
                                <TextBlock Grid.Column="2" Text="诊断" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="设置">
                        <Border Height="44" Padding="14,0" CornerRadius="7">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="4" Height="26" CornerRadius="2" Background="{StaticResource SideDockPrimaryBrush}" Opacity="0" />
                                <FontIcon Grid.Column="1" Glyph="&#xE713;" FontSize="18" Foreground="#30363D" />
                                <TextBlock Grid.Column="2" Text="设置" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                            </Grid>
                        </Border>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="18">
                    <Rectangle Height="1" Fill="#CBD5DE" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Width="10"
                            Height="10"
                            Fill="#238A25"
                            VerticalAlignment="Top"
                            Margin="0,5,0,0" />
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="主机服务" FontSize="13" Foreground="#5B6570" />
                            <TextBlock Text="正在运行" FontSize="13" Foreground="#30363D" />
                            <TextBlock x:Name="StaticDisplaySidebarVersionText" Margin="0,7,0,0" FontSize="12" Foreground="#6B7280" />
                        </StackPanel>
                    </Grid>
                    <Button
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="折叠菜单">
                        <Grid ColumnSpacing="12" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="#30363D" />
                            <TextBlock Grid.Column="1" Text="折叠菜单" VerticalAlignment="Center" FontSize="13" Foreground="#30363D" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0" />
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>

            <Grid Padding="26,0,26,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="虚拟显示器"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="#0F172A" />

                <Button
                    x:Name="TopStartDisplayButton"
                    Grid.Column="1"
                    Margin="26,0,0,0"
                    MinWidth="144"
                    Height="40"
                    Padding="18,0"
                    CornerRadius="6"
                    Background="{StaticResource SideDockPrimaryBrush}"
                    BorderBrush="{StaticResource SideDockPrimaryBrush}"
                    Foreground="White"
                    Click="StartDisplayButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="White" />
                        <TextBlock Text="启动显示器" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="TopInstallDriverButton"
                    Grid.Column="2"
                    Margin="16,0,0,0"
                    Style="{StaticResource StaticOutlineButtonStyle}"
                    Click="InstallDriverButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="#30363D" />
                        <TextBlock Text="安装/修复驱动" VerticalAlignment="Center" FontSize="13" Foreground="#30363D" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="TopDisplaySettingsButton"
                    Grid.Column="3"
                    Margin="14,0,0,0"
                    Style="{StaticResource StaticOutlineButtonStyle}"
                    Click="DisplaySettingsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8A7;" FontSize="16" Foreground="#30363D" />
                        <TextBlock Text="打开显示设置" VerticalAlignment="Center" FontSize="13" Foreground="#30363D" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <Button
                        x:Name="TopRefreshButton"
                        Style="{StaticResource StaticGhostButtonStyle}"
                        Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="#111827" />
                            <TextBlock Text="刷新" VerticalAlignment="Center" FontSize="13" Foreground="#111827" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StaticGhostButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="#111827" />
                            <TextBlock Text="操作" VerticalAlignment="Center" FontSize="13" Foreground="#111827" />
                            <FontIcon Glyph="&#xE70D;" FontSize="12" Foreground="#111827" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                Padding="26,0,26,0"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <Grid RowSpacing="14" Margin="0,0,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="StatusBanner"
                        Padding="18,0"
                        CornerRadius="7"
                        Background="#F1FAEC"
                        BorderBrush="#62B360"
                        BorderThickness="1">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="StatusBannerIconBackground"
                                Width="38"
                                Height="38"
                                CornerRadius="19"
                                Background="{StaticResource SideDockSuccessBrush}">
                                <FontIcon
                                    x:Name="StatusBannerIcon"
                                    Glyph="&#xE73E;"
                                    FontSize="22"
                                    Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    x:Name="StatusBannerTitleText"
                                    Text="正在检测虚拟显示器"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#238A25" />
                                <TextBlock
                                    x:Name="StatusBannerMessageText"
                                    Text="正在读取驱动和设备工具状态。"
                                    FontSize="13"
                                    Foreground="#30363D"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="2" />
                            </StackPanel>
                            <Button
                                x:Name="StatusBannerCloseButton"
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                CornerRadius="5"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="关闭提示"
                                Click="StatusBannerCloseButton_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#111827" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.92*" />
                            <ColumnDefinition Width="1.08*" />
                        </Grid.ColumnDefinitions>

                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="486" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource StaticCardStyle}" Padding="16,14">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="显示器布局预览" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SideDockTextBrush}" />

                                    <Border
                                        x:Name="DisplayLayoutPreviewSurface"
                                        Grid.Row="1"
                                        Padding="18"
                                        CornerRadius="6"
                                        Background="#F7F7F7"
                                        BorderBrush="#D8DEE4"
                                        BorderThickness="1"
                                        SizeChanged="DisplayLayoutPreviewSurface_SizeChanged">
                                        <Grid>
                                            <Canvas x:Name="DisplayLayoutCanvas" />
                                            <TextBlock
                                                x:Name="DisplayLayoutPreviewStatusText"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                FontSize="13"
                                                Foreground="#5B6570"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="2" Margin="12,8,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Rectangle Width="32" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource SideDockPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="主屏幕（扩展桌面）" FontSize="13" Foreground="#30363D" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                            <Rectangle Width="32" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#0B67E3" VerticalAlignment="Center" />
                                            <TextBlock Text="虚拟显示器" FontSize="13" Foreground="#30363D" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                            <Rectangle
                                                Width="32"
                                                Height="16"
                                                RadiusX="2"
                                                RadiusY="2"
                                                Stroke="#30363D"
                                                StrokeThickness="1"
                                                StrokeDashArray="3,2"
                                                Fill="Transparent"
                                                VerticalAlignment="Center" />
                                            <TextBlock Text="未检测到的显示器" FontSize="13" Foreground="#30363D" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.12*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource StaticCardStyle}" Padding="14">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="#30363D" />
                                            <TextBlock Text="显示模式" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SideDockTextBrush}" />
                                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="#6B7280" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="选择虚拟显示器的显示模式" FontSize="12" Foreground="#5B6570" />
                                        <Grid Grid.Row="2" RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="34" />
                                                <RowDefinition Height="64" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="40" />
                                            </Grid.RowDefinitions>
                                            <Border
                                                x:Name="DisplayPresentationOptionsPanel"
                                                CornerRadius="5"
                                                BorderBrush="#D8DEE4"
                                                BorderThickness="1"
                                                Background="#F8FAFC">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        x:Name="DisplayPresentationExtendOption"
                                                        CornerRadius="5"
                                                        Tag="Extend"
                                                        Tapped="PresentationModeOption_Tapped">
                                                        <TextBlock
                                                            x:Name="DisplayPresentationExtendText"
                                                            Text="扩展"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="13" />
                                                    </Border>
                                                    <Border
                                                        x:Name="DisplayPresentationMirrorOption"
                                                        Grid.Column="1"
                                                        BorderBrush="#D8DEE4"
                                                        BorderThickness="1,0,1,0"
                                                        Tag="Mirror"
                                                        Tapped="PresentationModeOption_Tapped">
                                                        <TextBlock
                                                            x:Name="DisplayPresentationMirrorText"
                                                            Text="镜像"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="13" />
                                                    </Border>
                                                    <Border
                                                        x:Name="DisplayPresentationSecondaryOnlyOption"
                                                        Grid.Column="2"
                                                        CornerRadius="5"
                                                        Tag="SecondaryOnly"
                                                        Tapped="PresentationModeOption_Tapped">
                                                        <TextBlock
                                                            x:Name="DisplayPresentationSecondaryOnlyText"
                                                            Text="仅副屏"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="13" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border
                                                x:Name="DisplayPresentationModeDetailCard"
                                                Grid.Row="1"
                                                Padding="11,9"
                                                CornerRadius="5"
                                                Background="#F8FAFC"
                                                BorderBrush="#D8DEE4"
                                                BorderThickness="1">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        x:Name="DisplayPresentationModeIcon"
                                                        Glyph="&#xE7F4;"
                                                        FontSize="18"
                                                        Foreground="#30363D" />
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock
                                                            x:Name="DisplayPresentationModeTitleText"
                                                            Text="扩展模式"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="#30363D" />
                                                        <TextBlock
                                                            x:Name="DisplayPresentationModeDescriptionText"
                                                            Text="将虚拟显示器作为扩展桌面使用，可独立设置分辨率与刷新率。"
                                                            FontSize="11"
                                                            Foreground="#5B6570"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button
                                                        x:Name="CopyPresentationDiagnosticsButton"
                                                        Grid.Column="2"
                                                        Width="32"
                                                        Height="32"
                                                        Padding="0"
                                                        CornerRadius="5"
                                                        Background="#FFFFFF"
                                                        BorderBrush="#D8DEE4"
                                                        Visibility="Collapsed"
                                                        ToolTipService.ToolTip="复制诊断摘要"
                                                        Click="CopyPresentationDiagnosticsButton_Click">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" Foreground="#30363D" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="2" ColumnSpacing="12">
                                                <Border
                                                    x:Name="SecondaryOnlyRollbackPanel"
                                                    Padding="10,8"
                                                    CornerRadius="5"
                                                    Background="#FFF8ED"
                                                    BorderBrush="#F59E0B"
                                                    BorderThickness="1"
                                                    Visibility="Collapsed">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE7BA;" FontSize="17" Foreground="#9D5D00" />
                                                        <TextBlock
                                                            x:Name="SecondaryOnlyRollbackText"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Text="仅副屏已临时启用，请确认是否保留。"
                                                            TextWrapping="Wrap"
                                                            FontSize="11"
                                                            Foreground="#30363D" />
                                                        <Button
                                                            x:Name="KeepSecondaryOnlyButton"
                                                            Grid.Column="2"
                                                            Height="28"
                                                            MinWidth="54"
                                                            Padding="10,0"
                                                            CornerRadius="5"
                                                            Background="{StaticResource SideDockPrimaryBrush}"
                                                            BorderBrush="{StaticResource SideDockPrimaryBrush}"
                                                            Foreground="White"
                                                            Click="KeepSecondaryOnlyButton_Click">
                                                            <TextBlock Text="保留" FontSize="12" FontWeight="SemiBold" />
                                                        </Button>
                                                        <Button
                                                            x:Name="RestoreSecondaryOnlyButton"
                                                            Grid.Column="3"
                                                            Height="28"
                                                            MinWidth="54"
                                                            Padding="10,0"
                                                            CornerRadius="5"
                                                            Background="#FFFFFF"
                                                            BorderBrush="#D8DEE4"
                                                            Click="RestoreSecondaryOnlyButton_Click">
                                                            <TextBlock Text="恢复" FontSize="12" Foreground="#30363D" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <Grid Grid.Row="3" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE713;" FontSize="19" Foreground="#30363D" />
                                                    <TextBlock Text="自动管理" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SideDockTextBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    x:Name="AutoManageDisplaySwitch"
                                                    Grid.Column="1"
                                                    MinWidth="54"
                                                    IsOn="True"
                                                    OnContent=""
                                                    OffContent=""
                                                    Toggled="AutoManageDisplaySwitch_Toggled" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource StaticCardStyle}" Padding="14">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="30" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="#30363D" />
                                            <TextBlock Text="分辨率" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SideDockTextBrush}" />
                                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="#6B7280" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="设置虚拟显示器分辨率" FontSize="12" Foreground="#5B6570" />
                                        <StackPanel Grid.Row="2" Spacing="8">
                                            <Border
                                                x:Name="Resolution720pOption"
                                                Height="32"
                                                Padding="10,0"
                                                CornerRadius="5"
                                                BorderBrush="#D8DEE4"
                                                BorderThickness="1"
                                                Background="#FFFFFF"
                                                Tag="720p"
                                                Tapped="ResolutionOption_Tapped">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        x:Name="Resolution720pLabel"
                                                        Text="720p"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Foreground="#30363D" />
                                                    <TextBlock
                                                        x:Name="Resolution720pDetail"
                                                        Grid.Column="1"
                                                        Text="1280 × 720"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="#5B6570" />
                                                    <Border
                                                        x:Name="Resolution720pRadio"
                                                        Grid.Column="2"
                                                        Width="12"
                                                        Height="12"
                                                        Margin="18,0,0,0"
                                                        CornerRadius="6"
                                                        BorderBrush="#9CA3AF"
                                                        BorderThickness="1">
                                                        <Ellipse
                                                            x:Name="Resolution720pRadioDot"
                                                            Width="6"
                                                            Height="6"
                                                            Fill="White"
                                                            Visibility="Collapsed" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border
                                                x:Name="Resolution1080pOption"
                                                Height="32"
                                                Padding="10,0"
                                                CornerRadius="5"
                                                Background="{StaticResource SideDockPrimaryBrush}"
                                                Tag="1080p"
                                                Tapped="ResolutionOption_Tapped">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        x:Name="Resolution1080pLabel"
                                                        Text="1080p"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="White" />
                                                    <TextBlock
                                                        x:Name="Resolution1080pDetail"
                                                        Grid.Column="1"
                                                        Text="1920 × 1080"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="White" />
                                                    <Border
                                                        x:Name="Resolution1080pRadio"
                                                        Grid.Column="2"
                                                        Width="12"
                                                        Height="12"
                                                        Margin="18,0,0,0"
                                                        CornerRadius="6"
                                                        BorderBrush="White"
                                                        BorderThickness="1">
                                                        <Ellipse
                                                            x:Name="Resolution1080pRadioDot"
                                                            Width="6"
                                                            Height="6"
                                                            Fill="White" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border
                                                x:Name="Resolution2kOption"
                                                Height="32"
                                                Padding="10,0"
                                                CornerRadius="5"
                                                BorderBrush="#D8DEE4"
                                                BorderThickness="1"
                                                Background="#FFFFFF"
                                                Tag="2k"
                                                Tapped="ResolutionOption_Tapped">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        x:Name="Resolution2kLabel"
                                                        Text="2K"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Foreground="#30363D" />
                                                    <TextBlock
                                                        x:Name="Resolution2kDetail"
                                                        Grid.Column="1"
                                                        Text="2560 × 1440"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="#5B6570" />
                                                    <Border
                                                        x:Name="Resolution2kRadio"
                                                        Grid.Column="2"
                                                        Width="12"
                                                        Height="12"
                                                        Margin="18,0,0,0"
                                                        CornerRadius="6"
                                                        BorderBrush="#9CA3AF"
                                                        BorderThickness="1">
                                                        <Ellipse
                                                            x:Name="Resolution2kRadioDot"
                                                            Width="6"
                                                            Height="6"
                                                            Fill="White"
                                                            Visibility="Collapsed" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <Border Grid.Row="3" Padding="9,0" CornerRadius="4" Background="#F8FAFC" BorderBrush="#D8DEE4" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#6B7280" />
                                                <TextBlock Text="推荐分辨率：1920 × 1080" FontSize="11" Foreground="#5B6570" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource StaticCardStyle}" Padding="14">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="30" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xEC4A;" FontSize="18" Foreground="#30363D" />
                                            <TextBlock Text="刷新率" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SideDockTextBrush}" />
                                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="#6B7280" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="设置虚拟显示器刷新率" FontSize="12" Foreground="#5B6570" />
                                        <Border Grid.Row="2" CornerRadius="5" BorderBrush="#D8DEE4" BorderThickness="1" Background="#F8FAFC">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    x:Name="RefreshRate30Option"
                                                    Tag="30"
                                                    Tapped="RefreshRateOption_Tapped">
                                                    <TextBlock
                                                        x:Name="RefreshRate30Text"
                                                        Text="30 Hz"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Foreground="#30363D" />
                                                </Border>
                                                <Border
                                                    x:Name="RefreshRate60Option"
                                                    Grid.Column="1"
                                                    BorderBrush="#D8DEE4"
                                                    BorderThickness="1,0,1,0"
                                                    Tag="60"
                                                    Tapped="RefreshRateOption_Tapped">
                                                    <TextBlock
                                                        x:Name="RefreshRate60Text"
                                                        Text="60 Hz"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Foreground="#30363D" />
                                                </Border>
                                                <Border
                                                    x:Name="RefreshRate120Option"
                                                    Grid.Column="2"
                                                    CornerRadius="5"
                                                    Background="{StaticResource SideDockPrimaryBrush}"
                                                    Tag="120"
                                                    Tapped="RefreshRateOption_Tapped">
                                                    <TextBlock
                                                        x:Name="RefreshRate120Text"
                                                        Text="120 Hz"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="4" Padding="9,0" CornerRadius="4" Background="#F8FAFC" BorderBrush="#D8DEE4" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#6B7280" />
                                                <TextBlock Text="高刷新率需要设备与线缆支持" FontSize="11" Foreground="#5B6570" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid Grid.Column="1" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="252" />
                                <RowDefinition Height="214" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource StaticCardStyle}" Padding="16,14">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="驱动与运行状态" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SideDockTextBrush}" />
                                    <Border Grid.Row="1" CornerRadius="6" BorderBrush="#D8DEE4" BorderThickness="1" Background="#FFFFFF">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid ColumnSpacing="12" Padding="13,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE83D;" FontSize="18" Foreground="#30363D" />
                                                <TextBlock Grid.Column="1" Text="驱动状态" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                                <TextBlock
                                                    x:Name="DriverStatusText"
                                                    Grid.Column="2"
                                                    Text="检测中"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="#5B6570" />
                                            </Grid>
                                            <Rectangle Grid.Row="1" Height="1" Fill="#E5E7EB" VerticalAlignment="Top" />
                                            <Grid Grid.Row="1" ColumnSpacing="12" Padding="13,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="#30363D" />
                                                <TextBlock Grid.Column="1" Text="设备工具" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                                <TextBlock
                                                    x:Name="DeviceToolStatusText"
                                                    Grid.Column="2"
                                                    Text="检测中"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="#5B6570" />
                                            </Grid>
                                            <Rectangle Grid.Row="2" Height="1" Fill="#E5E7EB" VerticalAlignment="Top" />
                                            <Grid Grid.Row="2" ColumnSpacing="12" Padding="13,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE83D;" FontSize="18" Foreground="#30363D" />
                                                <TextBlock Grid.Column="1" Text="系统权限" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                                <TextBlock
                                                    x:Name="SystemPermissionStatusText"
                                                    Grid.Column="2"
                                                    Text="检测中"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="#5B6570" />
                                            </Grid>
                                            <Rectangle Grid.Row="3" Height="1" Fill="#E5E7EB" VerticalAlignment="Top" />
                                            <Grid Grid.Row="3" ColumnSpacing="12" Padding="13,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE7E8;" FontSize="18" Foreground="#30363D" />
                                                <TextBlock Grid.Column="1" Text="开机自启" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                                <TextBlock
                                                    x:Name="AutostartStatusText"
                                                    Grid.Column="2"
                                                    Text="未管理"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Foreground="#5B6570" />
                                                <ToggleSwitch
                                                    x:Name="AutostartSwitch"
                                                    Grid.Column="3"
                                                    MinWidth="54"
                                                    OnContent=""
                                                    OffContent=""
                                                    Toggled="AutostartSwitch_Toggled" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource StaticCardStyle}" Padding="16,14">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="操作" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SideDockTextBrush}" />
                                    <StackPanel Grid.Row="1" Spacing="10">
                                        <Button
                                            x:Name="SideStartDisplayButton"
                                            Height="38"
                                            CornerRadius="5"
                                            Background="{StaticResource SideDockPrimaryBrush}"
                                            BorderBrush="{StaticResource SideDockPrimaryBrush}"
                                            Foreground="White"
                                            Click="StartDisplayButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="White" />
                                                <TextBlock Text="启动显示器" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="SideStopDisplayButton"
                                            Height="38"
                                            CornerRadius="5"
                                            Background="#FFFFFF"
                                            BorderBrush="#D8DEE4"
                                            Click="StopDisplayButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE71A;" FontSize="16" Foreground="#30363D" />
                                                <TextBlock Text="停止显示器" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="SideRefreshButton"
                                            Height="38"
                                            CornerRadius="5"
                                            Background="#FFFFFF"
                                            BorderBrush="#D8DEE4"
                                            Click="RefreshButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="#30363D" />
                                                <TextBlock Text="重新检测" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="SideInstallDriverButton"
                                            Height="38"
                                            CornerRadius="5"
                                            Background="#FFFFFF"
                                            BorderBrush="#D8DEE4"
                                            Click="InstallDriverButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE83D;" FontSize="16" Foreground="#30363D" />
                                                <TextBlock Text="安装/修复驱动" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource StaticCardStyle}" Padding="16,14">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="32" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="活动日志" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SideDockTextBrush}" />
                                    <StackPanel
                                        x:Name="ActivityLogStackPanel"
                                        Grid.Row="1"
                                        Spacing="0" />
                                    <Button
                                        x:Name="ViewFullLogsButton"
                                        Grid.Row="2"
                                        Height="32"
                                        CornerRadius="5"
                                        Background="#FFFFFF"
                                        BorderBrush="#D8DEE4"
                                        Click="LogsButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="查看完整日志" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SideDockPrimaryBrush}" />
                                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="13" Foreground="#30363D" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Border
                Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#D4DCE3"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
                <Grid Padding="26,0,26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="FooterHostText"
                        Text="本机：暂无数据"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#5B6570" />
                    <Rectangle Grid.Column="1" Width="1" Height="16" Fill="#9CA3AF" Margin="18,0" />
                    <TextBlock
                        x:Name="FooterOsText"
                        Grid.Column="2"
                        Text="Windows"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#5B6570" />
                    <StackPanel Grid.Column="3" Margin="18,0,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Rectangle
                            x:Name="FooterNetworkStatusDot"
                            Width="8"
                            Height="8"
                            RadiusX="4"
                            RadiusY="4"
                            Fill="#A3AAB2" />
                        <TextBlock
                            x:Name="FooterNetworkText"
                            Text="网络：暂无数据"
                            FontSize="12"
                            Foreground="#5B6570" />
                    </StackPanel>
                    <Button
                        x:Name="FooterLogsButton"
                        Grid.Column="4"
                        Height="32"
                        Padding="8,0"
                        CornerRadius="5"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="LogsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="#30363D" />
                            <TextBlock Text="日志" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SideDockTextBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
