<UserControl
    x:Class="SideDock.Host.App.StaticSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SettingsPageBackgroundBrush" Color="#F6F8FA" />
        <SolidColorBrush x:Key="SettingsPanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SettingsStrokeBrush" Color="#D8DEE4" />
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="SettingsMutedBrush" Color="#5B6570" />
        <SolidColorBrush x:Key="SettingsPrimaryBrush" Color="#087C89" />

        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{StaticResource SettingsPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SettingsIconBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SettingsOutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsStrokeBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SettingsPageBackgroundBrush}">
        <ScrollViewer
            x:Name="SettingsScrollViewer"
            Padding="26,0,26,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="0,0,0,18">
                <Border
                    x:Name="SettingsSavedBanner"
                    Height="70"
                    Padding="18,0"
                    CornerRadius="7"
                    Background="#F1FAEC"
                    BorderBrush="#62B360"
                    BorderThickness="1">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="#238A25">
                            <FontIcon Glyph="&#xE73E;" FontSize="23" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                x:Name="SettingsSavedTitleText"
                                Text="设置已保存"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#1E7F23" />
                            <TextBlock
                                x:Name="SettingsSavedDetailText"
                                Text="所有更改已成功保存到本地配置。"
                                FontSize="12"
                                Foreground="{StaticResource SettingsTextBrush}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="5"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="DismissSavedBannerButton_Click"
                            ToolTipService.ToolTip="关闭提示">
                            <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#111827" />
                        </Button>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.08*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="0">
                                <TextBlock Text="应用行为" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SettingsTextBrush}" Margin="0,0,0,14" />

                                <Grid MinHeight="58" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsIconBoxStyle}">
                                        <FontIcon Glyph="&#xE7E8;" FontSize="19" Foreground="#30363D" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="开机启动" FontSize="14" Foreground="{StaticResource SettingsTextBrush}" />
                                        <TextBlock Text="在 Windows 启动时自动运行 SideDock Host" FontSize="12" Foreground="{StaticResource SettingsMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartWithWindowsSwitch" Grid.Column="2" MinWidth="54" IsOn="True" OnContent="" OffContent="" />
                                </Grid>
                                <Rectangle Height="1" Fill="#E5E7EB" Margin="0,10" />

                                <Grid MinHeight="58" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsIconBoxStyle}">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="19" Foreground="#30363D" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="关闭窗口时最小化到托盘" FontSize="14" Foreground="{StaticResource SettingsTextBrush}" />
                                        <TextBlock Text="关闭主窗口时最小化到系统托盘" FontSize="12" Foreground="{StaticResource SettingsMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="MinimizeToTraySwitch" Grid.Column="2" MinWidth="54" IsOn="True" OnContent="" OffContent="" />
                                </Grid>
                                <Rectangle Height="1" Fill="#E5E7EB" Margin="0,10" />

                                <Grid MinHeight="58" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsIconBoxStyle}">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="19" Foreground="#30363D" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="启动主机时自动启动虚拟显示器" FontSize="14" Foreground="{StaticResource SettingsTextBrush}" />
                                        <TextBlock Text="主机服务启动后自动启动虚拟显示器" FontSize="12" Foreground="{StaticResource SettingsMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutoDisplaySwitch" Grid.Column="2" MinWidth="54" IsOn="True" OnContent="" OffContent="" />
                                </Grid>
                                <Rectangle Height="1" Fill="#E5E7EB" Margin="0,10" />

                                <Grid MinHeight="58" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsIconBoxStyle}">
                                        <FontIcon Glyph="&#xE71B;" FontSize="19" Foreground="#30363D" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="启动主机时自动配置 ADB reverse" FontSize="14" Foreground="{StaticResource SettingsTextBrush}" />
                                        <TextBlock Text="连接设备后自动配置所需的 ADB reverse 端口" FontSize="12" Foreground="{StaticResource SettingsMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AdbReverseSwitch" Grid.Column="2" MinWidth="54" IsOn="True" OnContent="" OffContent="" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid RowSpacing="12" ColumnSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.ColumnSpan="2" Text="连接默认值" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SettingsTextBrush}" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="1" Text="默认设备" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                <ComboBox x:Name="DefaultDeviceCombo" Grid.Row="1" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="HA1K3AX0" />
                                    <ComboBoxItem Content="Pixel Tablet" />
                                    <ComboBoxItem Content="Android Debug Bridge" />
                                </ComboBox>

                                <TextBlock Grid.Row="2" Text="ADB 路径" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AdbPathBox" Text="C:\platform-tools\adb.exe" HorizontalAlignment="Stretch" />
                                    <Button
                                        x:Name="AdbPathBrowseButton"
                                        Grid.Column="1"
                                        Width="42"
                                        Padding="0"
                                        CornerRadius="0,5,5,0"
                                        Background="White"
                                        BorderBrush="{StaticResource SettingsStrokeBrush}"
                                        Click="AdbPathBrowseButton_Click">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="#30363D" />
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{StaticResource SettingsMutedBrush}" />
                                    <TextBlock Text="如果未找到 adb.exe，将提示设置路径。" FontSize="12" Foreground="{StaticResource SettingsMutedBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Row="4" Text="控制端口" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                <NumberBox x:Name="ControlPortBox" Grid.Row="4" Grid.Column="1" Value="27183" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />

                                <TextBlock Grid.Row="5" Text="视频端口" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                <NumberBox x:Name="VideoPortBox" Grid.Row="5" Grid.Column="1" Value="27184" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />

                                <TextBlock Grid.Row="6" Text="音频端口" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                <NumberBox x:Name="AudioPortBox" Grid.Row="6" Grid.Column="1" Value="27185" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />

                                <TextBlock Grid.Row="7" Text="摄像头端口" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                <NumberBox x:Name="CameraPortBox" Grid.Row="7" Grid.Column="1" Value="27186" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />

                                <Button
                                    Grid.Row="8"
                                    Grid.ColumnSpan="2"
                                    Width="150"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SettingsOutlineButtonStyle}"
                                    Click="RestorePortsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE72C;" FontSize="15" Foreground="#30363D" />
                                        <TextBlock Text="恢复默认端口" VerticalAlignment="Center" FontSize="13" Foreground="#30363D" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid RowSpacing="16" ColumnSpacing="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="外观" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SettingsTextBrush}" />

                                <TextBlock Grid.Row="1" Text="主题模式" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                <Grid Grid.Row="1" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="36" CornerRadius="5,0,0,5" Background="White" BorderBrush="{StaticResource SettingsStrokeBrush}" BorderThickness="1">
                                        <TextBlock Text="浅色" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" Foreground="#30363D" />
                                    </Border>
                                    <Border Grid.Column="1" Height="36" Background="White" BorderBrush="{StaticResource SettingsStrokeBrush}" BorderThickness="0,1,1,1">
                                        <TextBlock Text="深色" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" Foreground="#30363D" />
                                    </Border>
                                    <Border Grid.Column="2" Height="36" CornerRadius="0,5,5,0" Background="{StaticResource SettingsPrimaryBrush}" BorderBrush="{StaticResource SettingsPrimaryBrush}" BorderThickness="1">
                                        <TextBlock Text="跟随系统" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="2" Text="界面密度" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="36" CornerRadius="5,0,0,5" Background="White" BorderBrush="{StaticResource SettingsStrokeBrush}" BorderThickness="1">
                                        <TextBlock Text="紧凑" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" Foreground="#30363D" />
                                    </Border>
                                    <Border Grid.Column="1" Height="36" CornerRadius="0,5,5,0" Background="{StaticResource SettingsPrimaryBrush}" BorderBrush="{StaticResource SettingsPrimaryBrush}" BorderThickness="1">
                                        <TextBlock Text="标准" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="0">
                                <TextBlock Text="诊断与日志" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SettingsTextBrush}" Margin="0,0,0,14" />

                                <Grid MinHeight="58" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsIconBoxStyle}">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="19" Foreground="#30363D" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="保留最近日志" FontSize="14" Foreground="{StaticResource SettingsTextBrush}" />
                                        <TextBlock Text="保留最近日志文件以便排查问题（建议开启）" FontSize="12" Foreground="{StaticResource SettingsMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="RecentLogsSwitch" Grid.Column="2" MinWidth="54" IsOn="True" OnContent="" OffContent="" />
                                </Grid>
                                <Rectangle Height="1" Fill="#E5E7EB" Margin="0,10" />

                                <Grid MinHeight="58" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsIconBoxStyle}">
                                        <FontIcon Glyph="&#xE946;" FontSize="19" Foreground="#30363D" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="复制诊断时包含端口信息" FontSize="14" Foreground="{StaticResource SettingsTextBrush}" />
                                        <TextBlock Text="将端口映射与服务状态包含到诊断信息中" FontSize="12" Foreground="{StaticResource SettingsMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="IncludePortInfoSwitch" Grid.Column="2" MinWidth="54" IsOn="True" OnContent="" OffContent="" />
                                </Grid>

                                <Grid Margin="0,12,0,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Width="150" Style="{StaticResource SettingsOutlineButtonStyle}" Click="CleanLogsButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="#30363D" />
                                            <TextBlock Text="清理日志..." VerticalAlignment="Center" FontSize="13" Foreground="#30363D" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="LogSizeText" Text="当前日志大小： 24.7 MB" FontSize="12" Foreground="{StaticResource SettingsMutedBrush}" />
                                        <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#30363D" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid RowSpacing="12" ColumnSpacing="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="高级" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SettingsTextBrush}" />

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="NV12 处理池（帧）" FontSize="14" Foreground="#30363D" />
                                    <TextBlock Text="增加可减少掉帧，但会占用更多显存。" FontSize="12" Foreground="{StaticResource SettingsMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <NumberBox x:Name="Nv12ThreadsBox" Grid.Row="1" Grid.Column="1" Value="4" Minimum="1" Maximum="16" SpinButtonPlacementMode="Compact" />

                                <StackPanel Grid.Row="2" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="编码包队列（帧）" FontSize="14" Foreground="#30363D" />
                                    <TextBlock Text="增加可提升吞吐量，但会增加延迟。" FontSize="12" Foreground="{StaticResource SettingsMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <NumberBox x:Name="EncoderQueueBox" Grid.Row="2" Grid.Column="1" Value="2" Minimum="1" Maximum="8" SpinButtonPlacementMode="Compact" />

                                <Border Grid.Row="3" Grid.ColumnSpan="2" Padding="14,10" CornerRadius="5" Background="#FFF8EA" BorderBrush="#E9A23B" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="#D97706" />
                                        <TextBlock Text="高级设置可能影响稳定性或延迟，除非必要请保留默认值。" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SettingsMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" CornerRadius="8" Background="#0F172A">
                                    <Image Source="ms-appx:///Assets/SideDock.ico" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="SideDock Host  v1.3.0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SettingsTextBrush}" />
                                    <TextBlock Text="Windows Host Console for Android Tablets" FontSize="12" Foreground="{StaticResource SettingsMutedBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="© 2024 SideDock. 保留所有权利。" FontSize="11" Foreground="#6B7280" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                                    <Button MinWidth="140" Style="{StaticResource SettingsOutlineButtonStyle}" Click="CheckUpdateButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE72C;" FontSize="15" Foreground="#30363D" />
                                            <TextBlock Text="检查更新" VerticalAlignment="Center" FontSize="13" Foreground="#30363D" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="UpdateStatusText" Text="当前已是最新版本" FontSize="12" Foreground="{StaticResource SettingsMutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
