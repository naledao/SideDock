<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableMsixTooling Condition="'$(PublishSingleFile)' == 'true'">true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SideDock.Host.App</AssemblyName>
    <RootNamespace>SideDock.Host.App</RootNamespace>
    <ApplicationIcon>..\..\assets\SideDock.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260508005" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="HostPayload.zip" Condition="Exists('HostPayload.zip')" />
    <EmbeddedResource Include="DriverInstallerPayload.zip" Condition="Exists('DriverInstallerPayload.zip')" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="platform-tools\win-x64\**\*" Condition="Exists('platform-tools\win-x64')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RequireHostPayload" BeforeTargets="BeforeBuild" Condition="'$(CI)' == 'true' and !Exists('HostPayload.zip')">
    <Error Text="HostPayload.zip is required for CI app builds." />
  </Target>
</Project>
