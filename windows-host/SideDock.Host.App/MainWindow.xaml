<Window
    x:Class="SideDock.Host.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SideDock.Host.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SideDock Host">

    <Grid x:Name="RootShell" Background="#F6F8FA">
        <Grid x:Name="StaticOverviewShell" Background="#F6F8FA">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OverviewSidebarColumn" Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="OverviewSidebarBorder"
                Background="#F1F5F8"
                BorderBrush="#D4DCE3"
                BorderThickness="0,0,1,0">
                <Grid x:Name="OverviewSidebarContent" Padding="18,18,18,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            Width="34"
                            Height="34"
                            CornerRadius="7"
                            Background="Transparent">
                            <Image
                                Source="ms-appx:///Assets/SideDock.ico"
                                Stretch="Uniform" />
                        </Border>
                        <TextBlock
                            x:Name="OverviewAppTitleText"
                            Text="SideDock Host"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#111827" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,36,0,0" Spacing="8">
                        <Button
                            x:Name="OverviewNavOverviewButton"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OverviewNavOverviewButton_Click"
                            ToolTipService.ToolTip="总览">
                            <Border
                                x:Name="OverviewNavOverviewItem"
                                Height="44"
                                Padding="14,0"
                                CornerRadius="7"
                                Background="#E6EBEF">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        x:Name="OverviewNavOverviewIndicator"
                                        Width="4"
                                        Height="26"
                                        HorizontalAlignment="Left"
                                        CornerRadius="2"
                                        Background="#087C89" />
                                    <FontIcon
                                        x:Name="OverviewNavOverviewIcon"
                                        Grid.Column="1"
                                        Glyph="&#xE80F;"
                                        FontSize="18"
                                        Foreground="#087C89" />
                                    <TextBlock
                                        x:Name="OverviewNavOverviewText"
                                        Grid.Column="2"
                                        Text="总览"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="#111827" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button
                            x:Name="OverviewNavConnectionButton"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OverviewNavConnectionButton_Click"
                            ToolTipService.ToolTip="连接">
                            <Border x:Name="OverviewNavConnectionItem" Height="44" Padding="14,0" CornerRadius="7">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="OverviewNavConnectionIndicator" Width="4" Height="26" HorizontalAlignment="Left" CornerRadius="2" Background="#087C89" Opacity="0" />
                                    <FontIcon x:Name="OverviewNavConnectionIcon" Grid.Column="1" Glyph="&#xE71B;" FontSize="18" Foreground="#30363D" />
                                    <TextBlock x:Name="OverviewNavConnectionText" Grid.Column="2" Text="连接" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button
                            x:Name="OverviewNavDisplayButton"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OverviewNavDisplayButton_Click"
                            ToolTipService.ToolTip="虚拟显示器">
                            <Border x:Name="OverviewNavDisplayItem" Height="44" Padding="14,0" CornerRadius="7">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="OverviewNavDisplayIndicator" Width="4" Height="26" HorizontalAlignment="Left" CornerRadius="2" Background="#087C89" Opacity="0" />
                                    <FontIcon x:Name="OverviewNavDisplayIcon" Grid.Column="1" Glyph="&#xE7F4;" FontSize="18" Foreground="#30363D" />
                                    <TextBlock x:Name="OverviewNavDisplayText" Grid.Column="2" Text="虚拟显示器" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button
                            x:Name="OverviewNavCameraButton"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OverviewNavCameraButton_Click"
                            ToolTipService.ToolTip="摄像头">
                            <Border x:Name="OverviewNavCameraItem" Height="44" Padding="14,0" CornerRadius="7">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="OverviewNavCameraIndicator" Width="4" Height="26" HorizontalAlignment="Left" CornerRadius="2" Background="#087C89" Opacity="0" />
                                    <FontIcon x:Name="OverviewNavCameraIcon" Grid.Column="1" Glyph="&#xE722;" FontSize="18" Foreground="#30363D" />
                                    <TextBlock x:Name="OverviewNavCameraText" Grid.Column="2" Text="摄像头" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button
                            x:Name="OverviewNavAudioButton"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OverviewNavAudioButton_Click"
                            ToolTipService.ToolTip="音频">
                            <Border x:Name="OverviewNavAudioItem" Height="44" Padding="14,0" CornerRadius="7">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="OverviewNavAudioIndicator" Width="4" Height="26" HorizontalAlignment="Left" CornerRadius="2" Background="#087C89" Opacity="0" />
                                    <FontIcon x:Name="OverviewNavAudioIcon" Grid.Column="1" Glyph="&#xE995;" FontSize="18" Foreground="#30363D" />
                                    <TextBlock x:Name="OverviewNavAudioText" Grid.Column="2" Text="音频" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button
                            x:Name="OverviewNavDiagnosticsButton"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OverviewNavDiagnosticsButton_Click"
                            ToolTipService.ToolTip="诊断">
                            <Border x:Name="OverviewNavDiagnosticsItem" Height="44" Padding="14,0" CornerRadius="7">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="OverviewNavDiagnosticsIndicator" Width="4" Height="26" HorizontalAlignment="Left" CornerRadius="2" Background="#087C89" Opacity="0" />
                                    <FontIcon x:Name="OverviewNavDiagnosticsIcon" Grid.Column="1" Glyph="&#xE9D9;" FontSize="18" Foreground="#30363D" />
                                    <TextBlock x:Name="OverviewNavDiagnosticsText" Grid.Column="2" Text="诊断" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button
                            x:Name="OverviewNavSettingsButton"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OverviewNavSettingsButton_Click"
                            ToolTipService.ToolTip="设置">
                            <Border x:Name="OverviewNavSettingsItem" Height="44" Padding="14,0" CornerRadius="7">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="OverviewNavSettingsIndicator" Width="4" Height="26" HorizontalAlignment="Left" CornerRadius="2" Background="#087C89" Opacity="0" />
                                    <FontIcon x:Name="OverviewNavSettingsIcon" Grid.Column="1" Glyph="&#xE713;" FontSize="18" Foreground="#30363D" />
                                    <TextBlock x:Name="OverviewNavSettingsText" Grid.Column="2" Text="设置" VerticalAlignment="Center" FontSize="14" Foreground="#30363D" />
                                </Grid>
                            </Border>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="18">
                        <Rectangle Height="1" Fill="#CBD5DE" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                x:Name="OverviewSidebarHostStatusDot"
                                Width="10"
                                Height="10"
                                Fill="#A3AAB2"
                                VerticalAlignment="Top"
                                Margin="0,5,0,0" />
                            <StackPanel x:Name="OverviewSidebarHostStatusPanel" Grid.Column="1" Spacing="5">
                                <TextBlock x:Name="OverviewSidebarHostLabelText" Text="主机服务" FontSize="13" Foreground="#5B6570" />
                                <TextBlock
                                    x:Name="OverviewSidebarHostStatusText"
                                    Text="未启动"
                                    FontSize="13"
                                    Foreground="#30363D" />
                                <TextBlock x:Name="OverviewSidebarVersionText" Margin="0,7,0,0" FontSize="12" Foreground="#6B7280" />
                            </StackPanel>
                        </Grid>
                        <Button
                            x:Name="OverviewSidebarToggleButton"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OverviewSidebarToggleButton_Click"
                            ToolTipService.ToolTip="折叠菜单">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="OverviewSidebarToggleIcon" Glyph="&#xE72B;" FontSize="16" Foreground="#30363D" />
                                <TextBlock x:Name="OverviewSidebarToggleText" Grid.Column="1" Text="折叠菜单" VerticalAlignment="Center" FontSize="13" Foreground="#30363D" />
                            </Grid>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <Grid x:Name="OverviewRightShell" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>

                <Grid Padding="26,0,26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="OverviewPageTitleText"
                        Text="设备总览"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="#0F172A" />

                    <Button
                        x:Name="OverviewStartHostButton"
                        Grid.Column="1"
                        Margin="26,0,0,0"
                        MinWidth="144"
                        Height="40"
                        Padding="18,0"
                        CornerRadius="6"
                        Background="#087C89"
                        BorderBrush="#087C89"
                        Foreground="White"
                        Click="OverviewPrimaryActionButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon x:Name="OverviewPrimaryActionIcon" Glyph="&#xE768;" FontSize="16" Foreground="White" />
                            <TextBlock
                                x:Name="OverviewStartHostButtonText"
                                Text="启动主机"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <StackPanel
                        x:Name="OverviewDefaultHeaderActions"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="20"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="OverviewRefreshAdbDevicesButton"
                            MinWidth="76"
                            Height="34"
                            Padding="8,0"
                            CornerRadius="5"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OverviewRefreshButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="OverviewRefreshIcon" Glyph="&#xE72C;" FontSize="16" Foreground="#111827" />
                                <TextBlock x:Name="OverviewRefreshButtonText" Text="刷新" VerticalAlignment="Center" FontSize="13" Foreground="#111827" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="OverviewCameraHeaderCopyLogButton"
                            MinWidth="104"
                            Height="34"
                            Padding="8,0"
                            CornerRadius="5"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="OverviewCameraHeaderCopyLogButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="#111827" />
                                <TextBlock x:Name="OverviewCameraHeaderCopyLogButtonText" Text="复制日志" VerticalAlignment="Center" FontSize="13" Foreground="#111827" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="OverviewDisplayHeaderCopyLogButton"
                            MinWidth="104"
                            Height="34"
                            Padding="8,0"
                            CornerRadius="5"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="OverviewDisplayHeaderCopyLogButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="#111827" />
                                <TextBlock x:Name="OverviewDisplayHeaderCopyLogButtonText" Text="复制日志" VerticalAlignment="Center" FontSize="13" Foreground="#111827" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="OverviewCameraHeaderCopyAndroidLogButton"
                            MinWidth="120"
                            Height="34"
                            Padding="8,0"
                            CornerRadius="5"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="OverviewCameraHeaderCopyAndroidLogButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="#111827" />
                                <TextBlock x:Name="OverviewCameraHeaderCopyAndroidLogButtonText" Text="复制安卓日志" VerticalAlignment="Center" FontSize="13" Foreground="#111827" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="OverviewActionsButton"
                            Height="34"
                            Padding="8,0"
                            CornerRadius="5"
                            Background="Transparent"
                            BorderThickness="0">
                            <Button.Flyout>
                                <MenuFlyout x:Name="OverviewActionsMenuFlyout" Opening="OverviewActionsMenuFlyout_Opening">
                                    <MenuFlyoutItem x:Name="OverviewActionStartHostMenuItem" Text="启动主机" Click="OverviewActionStartHostMenuItem_Click" />
                                    <MenuFlyoutItem x:Name="OverviewActionStopHostMenuItem" Text="停止主机" Click="OverviewActionStopHostMenuItem_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="OverviewActionRefreshDevicesMenuItem" Text="刷新设备" Click="OverviewActionRefreshDevicesMenuItem_Click" />
                                    <MenuFlyoutItem x:Name="OverviewActionRestartAdbMenuItem" Text="重启 ADB" Click="OverviewActionRestartAdbMenuItem_Click" />
                                    <MenuFlyoutItem x:Name="OverviewActionRepairEndpointsMenuItem" Text="修复端点" Click="OverviewActionRepairEndpointsMenuItem_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="OverviewActionOpenDisplaySettingsMenuItem" Text="打开显示设置" Click="OverviewActionOpenDisplaySettingsMenuItem_Click" />
                                    <MenuFlyoutItem x:Name="OverviewActionCopyDiagnosticsMenuItem" Text="复制诊断" Click="OverviewActionCopyDiagnosticsMenuItem_Click" />
                                    <MenuFlyoutItem x:Name="OverviewActionOpenLogsMenuItem" Text="打开日志" Click="OverviewActionOpenLogsMenuItem_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="#111827" />
                                <TextBlock Text="操作" VerticalAlignment="Center" FontSize="13" Foreground="#111827" />
                                <FontIcon Glyph="&#xE70D;" FontSize="12" Foreground="#111827" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel
                        x:Name="OverviewAudioHeaderActions"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Button
                            x:Name="OverviewAudioHeaderRefreshButton"
                            MinWidth="128"
                            Height="40"
                            Padding="16,0"
                            CornerRadius="6"
                            Background="#FFFFFF"
                            BorderBrush="#D8DEE4"
                            Click="OverviewAudioHeaderRefreshButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE72C;" FontSize="17" Foreground="#111827" />
                                <TextBlock Text="刷新端点" VerticalAlignment="Center" FontSize="13" Foreground="#111827" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="OverviewAudioHeaderInstallButton"
                            MinWidth="206"
                            Height="40"
                            Padding="16,0"
                            CornerRadius="6"
                            Background="#FFFFFF"
                            BorderBrush="#D8DEE4"
                            Click="OverviewAudioHeaderInstallButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE90F;" FontSize="17" Foreground="#111827" />
                                <TextBlock Text="安装/修复虚拟音频线" VerticalAlignment="Center" FontSize="13" Foreground="#111827" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="OverviewAudioHeaderCopyLogButton"
                            MinWidth="132"
                            Height="40"
                            Padding="16,0"
                            CornerRadius="6"
                            Background="#FFFFFF"
                            BorderBrush="#D8DEE4"
                            Click="OverviewAudioHeaderCopyLogButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8C8;" FontSize="17" Foreground="#111827" />
                                <TextBlock Text="复制日志" VerticalAlignment="Center" FontSize="13" Foreground="#111827" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel
                        x:Name="OverviewSettingsHeaderActions"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Button
                            x:Name="OverviewSettingsSaveButton"
                            MinWidth="124"
                            Height="40"
                            Padding="18,0"
                            CornerRadius="6"
                            Background="#087C89"
                            BorderBrush="#087C89"
                            Click="OverviewSettingsSaveButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="White" />
                                <TextBlock Text="保存" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="OverviewSettingsRestoreButton"
                            MinWidth="128"
                            Height="36"
                            Padding="16,0"
                            CornerRadius="5"
                            Background="White"
                            BorderBrush="#D8DEE4"
                            Click="OverviewSettingsRestoreButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="#30363D" />
                                <TextBlock Text="恢复默认" VerticalAlignment="Center" FontSize="13" Foreground="#30363D" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="OverviewSettingsOpenDataDirectoryButton"
                            MinWidth="154"
                            Height="36"
                            Padding="16,0"
                            CornerRadius="5"
                            Background="White"
                            BorderBrush="#D8DEE4"
                            Click="OverviewSettingsOpenDataDirectoryButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="#30363D" />
                                <TextBlock Text="打开数据目录" VerticalAlignment="Center" FontSize="13" Foreground="#30363D" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer
                        x:Name="OverviewMainScrollViewer"
                        Padding="26,0,26,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="OverviewMainContentGrid" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="OverviewEnvironmentStatusBanner"
                            Height="52"
                            Padding="16,0"
                            CornerRadius="7"
                            Background="#F8FAFC"
                            BorderBrush="#D8DEE4"
                            BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="OverviewEnvironmentStatusIconBackground"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="16"
                                    Background="#6B7280">
                                    <FontIcon
                                        x:Name="OverviewEnvironmentStatusIcon"
                                        Glyph="&#xE711;"
                                        FontSize="19"
                                        Foreground="White" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock
                                        x:Name="OverviewEnvironmentStatusTitleText"
                                        Text="等待连接环境"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="#30363D" />
                                    <TextBlock
                                        x:Name="OverviewEnvironmentStatusDetailText"
                                        Text="请先刷新 Android 设备状态。"
                                        FontSize="12"
                                        Foreground="#5B6570" />
                                </StackPanel>
                                <Button
                                    x:Name="OverviewEnvironmentBannerDismissButton"
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="5"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OverviewEnvironmentBannerDismissButton_Click"
                                    ToolTipService.ToolTip="折叠状态横幅">
                                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#111827" />
                                </Button>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="OverviewNavigationDetailPanel"
                            Grid.Row="1"
                            Padding="18,14"
                            CornerRadius="7"
                            Background="#FFFFFF"
                            BorderBrush="#D8DEE4"
                            BorderThickness="1"
                            Visibility="Collapsed">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="38"
                                    Height="38"
                                    CornerRadius="19"
                                    Background="#087C89">
                                    <FontIcon
                                        x:Name="OverviewNavigationDetailIcon"
                                        Glyph="&#xE713;"
                                        FontSize="21"
                                        Foreground="White" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock
                                        x:Name="OverviewNavigationDetailTitleText"
                                        Text="设置"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="#111827" />
                                    <TextBlock
                                        x:Name="OverviewNavigationDetailText"
                                        Text="这里将承载对应设置入口。"
                                        FontSize="13"
                                        Foreground="#5B6570"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
