<Window
    x:Class="SideDock.Host.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SideDock Host">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid
                MaxWidth="1080"
                Padding="28"
                HorizontalAlignment="Stretch"
                RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="SideDock"
                            FontSize="32"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Windows host controls for virtual display, streaming, and input"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="14" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="12,8"
                        CornerRadius="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE7F4;"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                x:Name="OverallStatusText"
                                Text="Stopped"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="Session"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Choose the capture source and streaming target settings."
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Grid ColumnSpacing="14" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Video source" />
                                    <ComboBox
                                        x:Name="VideoSourceCombo"
                                        SelectedIndex="0"
                                        HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="idd-gpu" />
                                        <ComboBoxItem Content="idd" />
                                        <ComboBoxItem Content="realtime" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Resolution" />
                                    <ComboBox
                                        x:Name="ResolutionCombo"
                                        SelectedIndex="0"
                                        HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="720p" />
                                        <ComboBoxItem Content="1080p" />
                                        <ComboBoxItem Content="2k" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="Refresh rate" />
                                    <ComboBox
                                        x:Name="RefreshRateCombo"
                                        SelectedIndex="0"
                                        HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="30" />
                                        <ComboBoxItem Content="60" />
                                        <ComboBoxItem Content="120" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="6">
                                    <TextBlock Text="Control port" />
                                    <NumberBox
                                        x:Name="ControlPortBox"
                                        Value="27183"
                                        Minimum="1"
                                        Maximum="65535"
                                        SpinButtonPlacementMode="Hidden" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Video port" />
                                    <NumberBox
                                        x:Name="VideoPortBox"
                                        Value="27184"
                                        Minimum="1"
                                        Maximum="65535"
                                        SpinButtonPlacementMode="Hidden" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
                                    <TextBlock Text="ADB path" />
                                    <TextBox
                                        x:Name="AdbPathBox"
                                        PlaceholderText="Optional adb.exe path" />
                                </StackPanel>
                            </Grid>

                            <ToggleSwitch
                                x:Name="InputInjectionSwitch"
                                Header="Input injection"
                                IsOn="True" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    x:Name="StartHostButton"
                                    Click="StartHostButton_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="Start Host" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="StopHostButton"
                                    Click="StopHostButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                        <TextBlock Text="Stop Host" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="20">
                        <Border
                            Padding="20"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="Virtual Display"
                                        FontSize="20"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="SideDock.Idd.DeviceTool keeps the software display online."
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Border
                                    Padding="14"
                                    CornerRadius="8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Glyph="&#xE7F4;"
                                            FontSize="22"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                x:Name="DisplayStatusText"
                                                Text="Display Off"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                x:Name="DisplayStatusSubtext"
                                                Text="The virtual display tool is not running."
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ToggleSwitch
                                    x:Name="ManageDisplaySwitch"
                                    Header="Manage with Host"
                                    IsOn="True" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        x:Name="StartDisplayButton"
                                        Click="StartDisplayButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            <TextBlock Text="Start Display" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="StopDisplayButton"
                                        Click="StopDisplayButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                            <TextBlock Text="Stop Display" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="20"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="Runtime"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="Host process is launched from the embedded payload."
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <FontIcon Grid.Row="1" Glyph="&#xE8A7;" FontSize="14" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="Virtual display control uses the installed or locally built device tool."
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <FontIcon Grid.Row="2" Glyph="&#xE946;" FontSize="14" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="Ports default to 27183 and 27184 for Android reverse forwarding."
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
