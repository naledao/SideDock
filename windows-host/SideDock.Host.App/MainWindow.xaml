<Window
    x:Class="SideDock.Host.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SideDock Host">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid
                MaxWidth="1080"
                Padding="28"
                HorizontalAlignment="Stretch"
                RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="SideDock"
                            FontSize="32"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Windows 副屏主机"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="14" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="12,8"
                        CornerRadius="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE7F4;"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                x:Name="OverallStatusText"
                                Text="未启动"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="连接会话"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="选择视频源、分辨率和 Android 连接端口。"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Grid ColumnSpacing="14" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="视频源" />
                                    <ComboBox
                                        x:Name="VideoSourceCombo"
                                        SelectedIndex="0"
                                        HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="idd-gpu" />
                                        <ComboBoxItem Content="idd" />
                                        <ComboBoxItem Content="realtime" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="分辨率" />
                                    <ComboBox
                                        x:Name="ResolutionCombo"
                                        SelectedIndex="0"
                                        HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="720p" />
                                        <ComboBoxItem Content="1080p" />
                                        <ComboBoxItem Content="2k" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="刷新率" />
                                    <ComboBox
                                        x:Name="RefreshRateCombo"
                                        SelectedIndex="2"
                                        HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="30" />
                                        <ComboBoxItem Content="60" />
                                        <ComboBoxItem Content="120" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="6">
                                    <TextBlock Text="控制端口" />
                                    <NumberBox
                                        x:Name="ControlPortBox"
                                        Value="27183"
                                        Minimum="1"
                                        Maximum="65535"
                                        SpinButtonPlacementMode="Hidden" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                    <TextBlock Text="视频端口" />
                                    <NumberBox
                                        x:Name="VideoPortBox"
                                        Value="27184"
                                        Minimum="1"
                                        Maximum="65535"
                                        SpinButtonPlacementMode="Hidden" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
                                    <TextBlock Text="ADB 路径" />
                                    <TextBox
                                        x:Name="AdbPathBox"
                                        PlaceholderText="可选 adb.exe 路径" />
                                </StackPanel>
                            </Grid>

                            <ToggleSwitch
                                x:Name="InputInjectionSwitch"
                                Header="启用触控输入"
                                IsOn="True" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    x:Name="StartHostButton"
                                    Click="StartHostButton_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="启动主机" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="StopHostButton"
                                    Click="StopHostButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                        <TextBlock Text="停止主机" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="20">
                        <Border
                            Padding="20"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                    Text="虚拟显示器"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="安装 SideDock 虚拟显示驱动后，可在 Windows 显示设置里看到第二块屏幕。"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                </StackPanel>

                                <Border
                                    Padding="14"
                                    CornerRadius="8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Glyph="&#xE7F4;"
                                            FontSize="22"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                x:Name="DisplayStatusText"
                                                Text="显示器未启动"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                x:Name="DisplayStatusSubtext"
                                                Text="虚拟显示器工具未运行。"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ToggleSwitch
                                    x:Name="ManageDisplaySwitch"
                                    Header="启动主机时自动启动虚拟显示器"
                                    IsOn="True" />

                                <Grid ColumnSpacing="8" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        x:Name="InstallDriverButton"
                                        Click="InstallDriverButton_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                                            <TextBlock Text="安装/修复驱动" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        x:Name="StartDisplayButton"
                                        Click="StartDisplayButton_Click"
                                        HorizontalAlignment="Stretch"
                                        Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            <TextBlock Text="启动显示器" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        x:Name="StopDisplayButton"
                                        Click="StopDisplayButton_Click"
                                        HorizontalAlignment="Stretch"
                                        Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                            <TextBlock Text="停止显示器" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock
                                        x:Name="DriverInstallStatusText"
                                        Grid.Row="1"
                                        Grid.ColumnSpan="3"
                                        Text="如首次使用，请先安装驱动。安装时会弹出管理员权限确认。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="20"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="运行状态"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="主机服务会从内置组件启动。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <FontIcon Grid.Row="1" Glyph="&#xE8A7;" FontSize="14" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="虚拟显示器由 SideDock.Idd.DeviceTool 保持在线。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <FontIcon Grid.Row="2" Glyph="&#xE946;" FontSize="14" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="Android 默认使用 27183 和 27184 端口连接。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
