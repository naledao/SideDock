<Window
    x:Class="SideDock.Host.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SideDock Host">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid
            MaxWidth="1080"
            Padding="28"
            HorizontalAlignment="Stretch"
            RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="SideDock"
                            FontSize="32"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Windows 副屏主机"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="14" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="12,8"
                        CornerRadius="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE7F4;"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                x:Name="OverallStatusText"
                                Text="未启动"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid
                    Grid.Row="1"
                    ColumnSpacing="20"
                    MinHeight="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <ScrollViewer
                            x:Name="ConnectionSessionScrollViewer"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="连接会话"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="选择视频源、分辨率和 Android 连接端口。"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Grid ColumnSpacing="14" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="视频源" />
                                    <ComboBox
                                        x:Name="VideoSourceCombo"
                                        SelectedIndex="0"
                                        HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="idd-gpu" />
                                        <ComboBoxItem Content="idd" />
                                        <ComboBoxItem Content="realtime" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="分辨率" />
                                    <ComboBox
                                        x:Name="ResolutionCombo"
                                        SelectedIndex="0"
                                        HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="720p" />
                                        <ComboBoxItem Content="1080p" />
                                        <ComboBoxItem Content="2k" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="刷新率" />
                                    <ComboBox
                                        x:Name="RefreshRateCombo"
                                        SelectedIndex="2"
                                        HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="30" />
                                        <ComboBoxItem Content="60" />
                                        <ComboBoxItem Content="120" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="6">
                                    <TextBlock Text="控制端口" />
                                    <NumberBox
                                        x:Name="ControlPortBox"
                                        Value="27183"
                                        Minimum="1"
                                        Maximum="65535"
                                        SpinButtonPlacementMode="Hidden" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                    <TextBlock Text="视频端口" />
                                    <NumberBox
                                        x:Name="VideoPortBox"
                                        Value="27184"
                                        Minimum="1"
                                        Maximum="65535"
                                        SpinButtonPlacementMode="Hidden" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
                                    <TextBlock Text="ADB 路径" />
                                    <TextBox
                                        x:Name="AdbPathBox"
                                        PlaceholderText="可选 adb.exe 路径" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Spacing="6">
                                    <TextBlock Text="Android 设备" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            x:Name="AdbDeviceCombo"
                                            SelectionChanged="AdbDeviceCombo_SelectionChanged"
                                            HorizontalAlignment="Stretch" />
                                        <Button
                                            Grid.Column="1"
                                            x:Name="RefreshAdbDevicesButton"
                                            Click="RefreshAdbDevicesButton_Click"
                                            Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                                <TextBlock Text="刷新" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            x:Name="RestartAdbButton"
                                            Click="RestartAdbButton_Click"
                                            Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                                <TextBlock Text="重启 ADB" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <ToggleSwitch
                                x:Name="InputInjectionSwitch"
                                Header="启用触控输入"
                                IsOn="True" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    x:Name="StartHostButton"
                                    Click="StartHostButton_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="启动主机" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="StopHostButton"
                                    Click="StopHostButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                        <TextBlock Text="停止主机" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            Text="摄像头预览"
                                            FontSize="18"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            x:Name="CameraStatusText"
                                            Text="Server: idle  Android: unknown"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="4"
                                        MinWidth="96"
                                        VerticalAlignment="Top">
                                        <TextBlock
                                            Text="镜头"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox
                                            x:Name="CameraFacingCombo"
                                            SelectedIndex="0"
                                            SelectionChanged="CameraFacingCombo_SelectionChanged"
                                            HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="后置" Tag="back" />
                                            <ComboBoxItem Content="前置" Tag="front" />
                                        </ComboBox>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        x:Name="ToggleCameraPreviewButton"
                                        Click="ToggleCameraPreviewButton_Click"
                                        Padding="8,6"
                                        VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                x:Name="ToggleCameraPreviewIcon"
                                                Glyph="&#xE890;"
                                                FontSize="14" />
                                            <TextBlock
                                                x:Name="ToggleCameraPreviewButtonText"
                                                Text="关闭预览" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        x:Name="CopyCameraDiagnosticsButton"
                                        Click="CopyCameraDiagnosticsButton_Click"
                                        Padding="8,6"
                                        VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                            <TextBlock
                                                x:Name="CopyCameraDiagnosticsButtonText"
                                                Text="复制诊断" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border
                                    Height="190"
                                    CornerRadius="8"
                                    Background="#FF101418"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Grid>
                                        <Image
                                            x:Name="CameraPreviewImage"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            x:Name="CameraPreviewPlaceholderText"
                                            Text="等待摄像头解码帧"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Grid ColumnSpacing="8" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Text="配置"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        x:Name="CameraConfigText"
                                        Grid.Column="1"
                                        Text="port 27186 · 1280x720@30 · video/avc"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="接收"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        x:Name="CameraMetricsText"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="0.0 fps · 0 kbps · frames 0 · decoded 0"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Text="虚拟"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Spacing="6">
                                        <TextBlock
                                            x:Name="VirtualCameraStatusText"
                                            Text="注册: 未注册 · 运行: 已停止 · 供帧: --"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="StartVirtualCameraButton"
                                                Click="StartVirtualCameraButton_Click"
                                                Padding="8,6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                                    <TextBlock Text="注册/启动" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="StopVirtualCameraButton"
                                                Click="StopVirtualCameraButton_Click"
                                                Padding="8,6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                                    <TextBlock Text="停止" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="RefreshVirtualCameraButton"
                                                Click="RefreshVirtualCameraButton_Click"
                                                Padding="8,6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                                    <TextBlock Text="刷新" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Row="3"
                                        Text="错误"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        x:Name="CameraErrorText"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Text="无"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid
                        Grid.Column="1"
                        RowSpacing="12"
                        MinHeight="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.1*" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="0.85*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Padding="20"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <ScrollViewer
                                x:Name="DisplayCardScrollViewer"
                                VerticalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                    Text="虚拟显示器"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="安装 SideDock 虚拟显示驱动后，可在 Windows 显示设置里看到第二块屏幕。"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                </StackPanel>

                                <Border
                                    Padding="14"
                                    CornerRadius="8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Glyph="&#xE7F4;"
                                            FontSize="22"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                x:Name="DisplayStatusText"
                                                Text="显示器未启动"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                x:Name="DisplayStatusSubtext"
                                                Text="虚拟显示器工具未运行。"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ToggleSwitch
                                    x:Name="ManageDisplaySwitch"
                                    Header="启动主机时自动启动虚拟显示器"
                                    IsOn="True" />

                                <Grid ColumnSpacing="8" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        x:Name="InstallDriverButton"
                                        Click="InstallDriverButton_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                                            <TextBlock Text="安装/修复驱动" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        x:Name="StartDisplayButton"
                                        Click="StartDisplayButton_Click"
                                        HorizontalAlignment="Stretch"
                                        Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            <TextBlock Text="启动显示器" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        x:Name="StopDisplayButton"
                                        Click="StopDisplayButton_Click"
                                        HorizontalAlignment="Stretch"
                                        Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                            <TextBlock Text="停止显示器" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock
                                        x:Name="DriverInstallStatusText"
                                        Grid.Row="1"
                                        Grid.ColumnSpan="3"
                                        Text="如首次使用，请先安装驱动。安装时会弹出管理员权限确认。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Padding="20"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <ScrollViewer
                                x:Name="AudioCardScrollViewer"
                                VerticalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="音频设备"
                                        FontSize="20"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="个人版使用 Windows 输出设备 loopback 捕获电脑声音，并通过虚拟音频线缆写入 Android 麦克风。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch
                                    x:Name="AudioDeviceSwitch"
                                    Header="启用音频设备"
                                    IsOn="True"
                                    Toggled="AudioSwitch_Toggled" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch
                                        x:Name="MicrophoneSwitch"
                                        Header="麦克风"
                                        IsOn="True"
                                        Toggled="AudioSwitch_Toggled" />
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        x:Name="SpeakerSwitch"
                                        Header="音响"
                                        IsOn="True"
                                        Toggled="AudioSwitch_Toggled" />
                                </Grid>

                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="Host 捕获电脑输出"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox
                                        x:Name="SpeakerCaptureEndpointCombo"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        MinWidth="320"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="AudioEndpointCombo_SelectionChanged" />
                                    <TextBlock
                                        x:Name="SpeakerCaptureEndpointStatusText"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Text="选择要发送到 Android 播放的 Windows 输出设备；Host 将使用 loopback 捕获它。"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="2"
                                        VerticalAlignment="Center"
                                        Text="Host 写入麦克风"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox
                                        x:Name="MicrophoneRenderEndpointCombo"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        MinWidth="320"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="AudioEndpointCombo_SelectionChanged" />
                                    <TextBlock
                                        x:Name="MicrophoneRenderEndpointStatusText"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Text="选择通话软件里要使用的麦克风/录制端，例如 Voicemeeter Out B3/B2/B1；Host 会自动匹配对应的可写入虚拟音频端。"
                                        TextWrapping="Wrap" />

                                    <Button
                                        x:Name="RefreshAudioEndpointsButton"
                                        Grid.Row="4"
                                        Grid.Column="2"
                                        Click="RefreshAudioEndpointsButton_Click"
                                        HorizontalAlignment="Right"
                                        Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                            <TextBlock Text="刷新端点" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="VirtualAudioCableInstallStatusText"
                                        Text="没有 CABLE Output 时，可先安装虚拟音频线；安装完成后刷新端点并选择 CABLE Output。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                    <Button
                                        x:Name="InstallVirtualAudioCableButton"
                                        Grid.Column="1"
                                        Click="InstallVirtualAudioCableButton_Click"
                                        HorizontalAlignment="Right"
                                        Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                                            <TextBlock Text="安装/修复虚拟音频线" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border
                                    Padding="14"
                                    CornerRadius="8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                                        <TextBlock
                                            x:Name="AudioOverallStatusText"
                                            Grid.Column="1"
                                            Text="等待 Android 设备连接"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Text="设备"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            x:Name="AudioCurrentDeviceText"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="等待 Android 设备"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Text="麦克风"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            x:Name="MicrophoneStatusText"
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Text="等待 Android 设备"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="3"
                                            Text="音响"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            x:Name="SpeakerStatusText"
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Text="等待 Android 设备"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="4"
                                            Text="提示"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            x:Name="AudioHintText"
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Text="等待 Android 设备连接。"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />

                                        <Button
                                            x:Name="CopyAudioLogButton"
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Click="CopyAudioLogButton_Click"
                                            HorizontalAlignment="Right"
                                            Padding="8,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                <TextBlock
                                                    x:Name="CopyAudioLogButtonText"
                                                    Text="复制错误日志" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Padding="20"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <ScrollViewer
                                x:Name="RuntimeCardScrollViewer"
                                VerticalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="8">
                                <TextBlock
                                    Text="运行状态"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="主机服务会从内置组件启动。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <FontIcon Grid.Row="1" Glyph="&#xE8A7;" FontSize="14" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="虚拟显示器由 SideDock.Idd.DeviceTool 保持在线。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <FontIcon Grid.Row="2" Glyph="&#xE8D7;" FontSize="14" />
                                    <TextBlock
                                        x:Name="AdbStatusText"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="ADB reverse 会在启动主机前自动检查并配置。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <FontIcon Grid.Row="3" Glyph="&#xE946;" FontSize="14" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Text="Android 默认使用 27183、27184 和 27186 端口连接。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
    </Grid>
</Window>
