                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <ScrollViewer
                                x:Name="AudioCardScrollViewer"
                                VerticalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="音频设备"
                                        FontSize="20"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="个人版使用 Windows 输出设备 loopback 捕获电脑声音，并通过虚拟音频线缆写入 Android 麦克风。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch
                                    x:Name="AudioDeviceSwitch"
                                    Header="启用音频设备"
                                    IsOn="True"
                                    Toggled="AudioSwitch_Toggled" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch
                                        x:Name="MicrophoneSwitch"
                                        Header="麦克风"
                                        IsOn="True"
                                        Toggled="AudioSwitch_Toggled" />
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        x:Name="SpeakerSwitch"
                                        Header="音响"
                                        IsOn="True"
                                        Toggled="AudioSwitch_Toggled" />
                                </Grid>

                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="Host 捕获电脑输出"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox
                                        x:Name="SpeakerCaptureEndpointCombo"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        MinWidth="320"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="AudioEndpointCombo_SelectionChanged" />
                                    <TextBlock
                                        x:Name="SpeakerCaptureEndpointStatusText"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Text="选择要发送到 Android 播放的 Windows 输出设备；Host 将使用 loopback 捕获它。"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="2"
                                        VerticalAlignment="Center"
                                        Text="Host 写入麦克风"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox
                                        x:Name="MicrophoneRenderEndpointCombo"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        MinWidth="320"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="AudioEndpointCombo_SelectionChanged" />
                                    <TextBlock
                                        x:Name="MicrophoneRenderEndpointStatusText"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Text="选择通话软件里要使用的麦克风/录制端，例如 Voicemeeter Out B3/B2/B1；Host 会自动匹配对应的可写入虚拟音频端。"
                                        TextWrapping="Wrap" />

                                    <Button
                                        x:Name="RefreshAudioEndpointsButton"
                                        Grid.Row="4"
                                        Grid.Column="2"
                                        Click="RefreshAudioEndpointsButton_Click"
                                        HorizontalAlignment="Right"
                                        Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                            <TextBlock Text="刷新端点" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="VirtualAudioCableInstallStatusText"
                                        Text="没有 CABLE Output 时，可先安装虚拟音频线；安装完成后刷新端点并选择 CABLE Output。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                    <Button
                                        x:Name="InstallVirtualAudioCableButton"
                                        Grid.Column="1"
                                        Click="InstallVirtualAudioCableButton_Click"
                                        HorizontalAlignment="Right"
                                        Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                                            <TextBlock Text="安装/修复虚拟音频线" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border
                                    Padding="14"
                                    CornerRadius="8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                                        <TextBlock
                                            x:Name="AudioOverallStatusText"
                                            Grid.Column="1"
                                            Text="等待 Android 设备连接"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Text="设备"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            x:Name="AudioCurrentDeviceText"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="等待 Android 设备"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Text="麦克风"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            x:Name="MicrophoneStatusText"
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Text="等待 Android 设备"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="3"
                                            Text="音响"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            x:Name="SpeakerStatusText"
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Text="等待 Android 设备"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Grid.Row="4"
                                            Text="提示"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            x:Name="AudioHintText"
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Text="等待 Android 设备连接。"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />

                                        <Button
                                            x:Name="CopyAudioLogButton"
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Click="CopyAudioLogButton_Click"
                                            HorizontalAlignment="Right"
                                            Padding="8,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                <TextBlock
                                                    x:Name="CopyAudioLogButtonText"
                                                    Text="复制错误日志" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Padding="20"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <ScrollViewer
                                x:Name="RuntimeCardScrollViewer"
                                VerticalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="8">
                                <TextBlock
                                    Text="运行状态"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="主机服务会从内置组件启动。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <FontIcon Grid.Row="1" Glyph="&#xE8A7;" FontSize="14" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="虚拟显示器由 SideDock.Idd.DeviceTool 保持在线。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <FontIcon Grid.Row="2" Glyph="&#xE8D7;" FontSize="14" />
                                    <TextBlock
                                        x:Name="AdbStatusText"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="ADB reverse 会在启动主机前自动检查并配置。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <FontIcon Grid.Row="3" Glyph="&#xE946;" FontSize="14" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Text="Android 默认使用 27183、27184 和 27186 端口连接。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>
